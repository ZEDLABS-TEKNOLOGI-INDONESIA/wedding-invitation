---
import AuthLayout from "../layouts/AuthLayout.astro";
import { getAuthSession } from "../lib/auth";

Astro.response.headers.set("Cache-Control", "no-store");

const session = getAuthSession(Astro.cookies);
if (session) {
  return Astro.redirect(session.role === "superadmin" ? "/superadmin" : "/admin");
}
---

<AuthLayout
  title="Masuk"
  description="Masuk dengan username & password akun Anda (Pemilik Undangan, Pasangan, atau Superadmin)."
>
  <form id="login-form" class="space-y-4">
    <div>
      <label for="username" class="adm-label">Username</label>
      <input
        id="username"
        name="username"
        type="text"
        required
        autocomplete="username"
        placeholder="contoh: fera atau superadmin"
        class="adm-input"
      />
    </div>

    <div>
      <div class="flex items-center justify-between">
        <label for="password" class="adm-label">Password</label>
        <a
          href="/lupa-password"
          class="text-xs font-medium text-(--adm-accent) hover:underline"
        >
          Lupa password?
        </a>
      </div>
      <input
        id="password"
        name="password"
        type="password"
        required
        autocomplete="current-password"
        placeholder="Masukkan password"
        class="adm-input"
      />
    </div>

    <div
      id="login-error"
      class="hidden rounded-lg border border-red-500/30 bg-red-500/10 px-3.5 py-2.5 text-xs text-red-400"
    >
    </div>

    <button id="login-submit" type="submit" class="adm-btn adm-btn-primary w-full">
      Masuk
    </button>
  </form>

  <p class="mt-5 text-center text-xs text-(--adm-text-secondary)">
    Belum punya akun undangan?{" "}
    <a href="/daftar" class="font-medium text-(--adm-accent) hover:underline">
      Daftar gratis sekarang
    </a>
  </p>

  <p class="mt-3 text-center text-[11px] text-(--adm-text-secondary)">
    Dengan masuk, Anda menyetujui{" "}
    <a href="/syarat-ketentuan" class="text-(--adm-accent) hover:underline">
      Syarat dan Ketentuan
    </a>{" "}
    dan{" "}
    <a href="/kebijakan-privasi" class="text-(--adm-accent) hover:underline">
      Kebijakan Privasi
    </a>
    .
  </p>
</AuthLayout>

<script>
  const form = document.getElementById("login-form") as HTMLFormElement | null;
  const errBox = document.getElementById("login-error");
  const submitBtn = document.getElementById("login-submit") as HTMLButtonElement | null;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!errBox || !submitBtn) return;
    errBox.classList.add("hidden");
    submitBtn.disabled = true;
    submitBtn.textContent = "Memeriksa...";

    const fd = new FormData(form);
    try {
      const res = await fetch("/api/auth/login", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        credentials: "include",
        body: JSON.stringify({
          username: fd.get("username"),
          password: fd.get("password"),
        }),
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.success) {
        window.location.href = data.redirectTo || "/admin";
        return;
      }
      errBox.textContent = data.error || "Gagal masuk. Periksa username & password.";
      errBox.classList.remove("hidden");
    } catch {
      errBox.textContent = "Gagal terhubung ke server.";
      errBox.classList.remove("hidden");
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = "Masuk";
    }
  });
</script>
