---
import AuthLayout from "../layouts/AuthLayout.astro";
import { getAuthSession } from "../lib/auth";

Astro.response.headers.set("Cache-Control", "no-store");

const session = getAuthSession(Astro.cookies);
if (session) {
  return Astro.redirect(session.role === "superadmin" ? "/superadmin" : "/admin");
}
---

<AuthLayout
  title="Masuk"
  description="Gunakan username dan kata sandi akun Anda (Pemilik Undangan, Pasangan, atau Superadmin)."
>
  <form id="login-form" class="space-y-4">
    <div>
      <label for="username" class="adm-label">Username</label>
      <input
        id="username"
        name="username"
        type="text"
        required
        autocomplete="username"
        placeholder="contoh: fera atau superadmin"
        class="adm-input"
      />
    </div>

    <div>
      <div class="flex items-center justify-between">
        <label for="password" class="adm-label">Kata sandi</label>
        <a href="/lupa-password" class="adm-link text-xs">
          Lupa kata sandi?
        </a>
      </div>
      <input
        id="password"
        name="password"
        type="password"
        required
        autocomplete="current-password"
        placeholder="Masukkan kata sandi"
        class="adm-input"
      />
    </div>

    <div
      id="login-error"
      role="alert"
      class="adm-alert adm-alert-danger hidden text-xs"
    >
    </div>

    <button
      id="login-submit"
      type="submit"
      class="adm-btn adm-btn-primary adm-btn-lg adm-btn-block"
    >
      Masuk ke panel
    </button>
  </form>

  <p class="mt-6 text-center text-sm text-(--adm-text-secondary)">
    Belum punya akun undangan?{" "}
    <a href="/daftar" class="adm-link font-medium">
      Daftar gratis sekarang
    </a>
  </p>

  <p class="mt-4 text-center text-xs text-(--adm-text-secondary)">
    Dengan masuk, Anda menyetujui{" "}
    <a href="/syarat-ketentuan" target="_blank" rel="noopener noreferrer" class="adm-link">
      Syarat dan Ketentuan
    </a>{" "}
    dan{" "}
    <a href="/kebijakan-privasi" target="_blank" rel="noopener noreferrer" class="adm-link">
      Kebijakan Privasi
    </a>
    .
  </p>
</AuthLayout>

<script>
  const form = document.getElementById("login-form") as HTMLFormElement | null;
  const errBox = document.getElementById("login-error");
  const submitBtn = document.getElementById("login-submit") as HTMLButtonElement | null;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!errBox || !submitBtn) return;
    errBox.classList.add("hidden");
    submitBtn.disabled = true;
    submitBtn.textContent = "Memeriksa...";

    const fd = new FormData(form);
    try {
      const res = await fetch("/api/auth/login", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        credentials: "include",
        body: JSON.stringify({
          username: fd.get("username"),
          password: fd.get("password"),
        }),
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.success) {
        window.location.href = data.redirectTo || "/admin";
        return;
      }
      errBox.textContent = data.error || "Gagal masuk. Periksa username & kata sandi.";
      errBox.classList.remove("hidden");
    } catch {
      errBox.textContent = "Gagal terhubung ke server.";
      errBox.classList.remove("hidden");
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = "Masuk ke panel";
    }
  });
</script>
