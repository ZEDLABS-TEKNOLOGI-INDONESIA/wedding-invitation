---
import Layout from "../layouts/Layout.astro";
import { getAuthSession } from "../lib/auth";

Astro.response.status = 404;
const session = getAuthSession(Astro.cookies);
const tujuan = !session ? "/" : session.role === "superadmin" ? "/superadmin" : "/admin";
const labelTujuan = session ? "Kembali ke dashboard" : "Ke beranda";
---

<Layout
  title="Halaman tidak ditemukan | Wedding Management"
  description="Alamat yang Anda buka tidak ditemukan atau sudah dipindahkan."
  noindex={true}
>
  <main class="admin-shell is-public flex min-h-dvh items-center justify-center bg-(--adm-bg-primary) px-6">
    <div class="max-w-md text-center">
      <p class="text-6xl font-semibold text-(--adm-accent) tabular-nums">404</p>
      <h1 class="mt-4 text-xl font-semibold text-(--adm-text-primary)">
        Halaman tidak ditemukan
      </h1>
      <p class="mt-2 text-sm text-(--adm-text-secondary)">
        Alamat yang Anda buka tidak tersedia atau slug undangan belum terdaftar.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-2">
        <a href={tujuan} class="adm-btn adm-btn-primary">
          {labelTujuan}
        </a>
        {!session && (
          <a href="/masuk" class="adm-btn adm-btn-secondary">
            Masuk
          </a>
        )}
      </div>
    </div>
  </main>
</Layout>
