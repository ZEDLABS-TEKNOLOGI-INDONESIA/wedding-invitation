---
import { ArrowLeft, Heart, ShieldCheck } from "lucide-react";
import Layout from "../layouts/Layout.astro";
import { getAuthSession } from "../lib/auth";

Astro.response.headers.set("Cache-Control", "no-store");

const session = getAuthSession(Astro.cookies);
if (session) {
  return Astro.redirect(session.role === "superadmin" ? "/superadmin" : "/admin");
}
---

<Layout title="Daftar Akun Undangan — Wedding SaaS" noindex={true}>
  <div class="flex min-h-dvh flex-col items-center justify-center bg-slate-950 px-4 py-10 text-slate-100">
    <div class="w-full max-w-lg space-y-6">
      <div class="text-center">
        <a
          href="/"
          class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-sky-500/15 text-sky-400 ring-1 ring-sky-400/30"
        >
          <Heart className="h-5 w-5" />
        </a>
        <h1 class="mt-4 font-serif text-2xl font-semibold text-white">
          Daftar Akun Undangan Baru
        </h1>
        <p class="mt-1 text-xs text-slate-400">
          Verifikasi via OTP WhatsApp. Setelah terdaftar, Anda dapat langsung
          menambahkan 1 akun pasangan Anda di dalam dashboard.
        </p>
      </div>

      {/* Step 1: Data Pendaftaran */}
      <form
        id="register-step1"
        class="space-y-4 rounded-2xl border border-white/10 bg-slate-900/90 p-6 shadow-xl"
      >
        <div class="grid gap-3 sm:grid-cols-2">
          <div class="space-y-1">
            <label for="brideNickname" class="block text-xs font-medium text-slate-300">
              Panggilan Mempelai Wanita *
            </label>
            <input
              id="brideNickname"
              name="brideNickname"
              type="text"
              required
              placeholder="Contoh: Danik"
              class="w-full rounded-xl border border-white/10 bg-slate-950 px-3 py-2 text-sm text-white placeholder-slate-500 focus:border-sky-400 focus:outline-none"
            />
          </div>
          <div class="space-y-1">
            <label for="groomNickname" class="block text-xs font-medium text-slate-300">
              Panggilan Mempelai Pria *
            </label>
            <input
              id="groomNickname"
              name="groomNickname"
              type="text"
              required
              placeholder="Contoh: Ikbal"
              class="w-full rounded-xl border border-white/10 bg-slate-950 px-3 py-2 text-sm text-white placeholder-slate-500 focus:border-sky-400 focus:outline-none"
            />
          </div>
        </div>

        <div class="space-y-1">
          <label for="slug" class="block text-xs font-medium text-slate-300">
            Alamat URL Undangan (Unik) *
          </label>
          <div class="flex items-center overflow-hidden rounded-xl border border-white/10 bg-slate-950 focus-within:border-sky-400">
            <span class="border-r border-white/10 bg-slate-900 px-3 py-2 text-xs text-slate-400">
              /u/
            </span>
            <input
              id="slug"
              name="slug"
              type="text"
              required
              placeholder="danik-ikbal"
              class="w-full bg-transparent px-3 py-2 text-sm text-white placeholder-slate-500 focus:outline-none"
            />
          </div>
          <p class="text-[11px] text-slate-400">
            Hanya huruf kecil, angka, dan tanda hubung. Tidak akan bercampur dengan pasangan lain.
          </p>
        </div>

        <div class="grid gap-3 sm:grid-cols-2">
          <div class="space-y-1">
            <label for="fullName" class="block text-xs font-medium text-slate-300">
              Nama Lengkap Anda *
            </label>
            <input
              id="fullName"
              name="fullName"
              type="text"
              required
              placeholder="Nama Anda"
              class="w-full rounded-xl border border-white/10 bg-slate-950 px-3 py-2 text-sm text-white placeholder-slate-500 focus:border-sky-400 focus:outline-none"
            />
          </div>
          <div class="space-y-1">
            <label for="phone" class="block text-xs font-medium text-slate-300">
              Nomor WhatsApp (untuk OTP) *
            </label>
            <input
              id="phone"
              name="phone"
              type="tel"
              required
              placeholder="081234567890"
              class="w-full rounded-xl border border-white/10 bg-slate-950 px-3 py-2 text-sm text-white placeholder-slate-500 focus:border-sky-400 focus:outline-none"
            />
          </div>
        </div>

        <div class="grid gap-3 sm:grid-cols-2">
          <div class="space-y-1">
            <label for="username" class="block text-xs font-medium text-slate-300">
              Username Login *
            </label>
            <input
              id="username"
              name="username"
              type="text"
              required
              autocomplete="username"
              placeholder="contoh: danik_ikbal"
              class="w-full rounded-xl border border-white/10 bg-slate-950 px-3 py-2 text-sm text-white placeholder-slate-500 focus:border-sky-400 focus:outline-none"
            />
          </div>
          <div class="space-y-1">
            <label for="password" class="block text-xs font-medium text-slate-300">
              Password (min. 6 karakter) *
            </label>
            <input
              id="password"
              name="password"
              type="password"
              required
              minlength="6"
              autocomplete="new-password"
              placeholder="••••••••"
              class="w-full rounded-xl border border-white/10 bg-slate-950 px-3 py-2 text-sm text-white placeholder-slate-500 focus:border-sky-400 focus:outline-none"
            />
          </div>
        </div>

        <div
          id="reg-error"
          class="hidden rounded-xl border border-red-500/30 bg-red-500/10 px-3.5 py-2.5 text-xs text-red-200"
        >
        </div>

        <button
          id="btn-send-otp"
          type="submit"
          class="w-full rounded-xl bg-sky-500 py-2.5 text-sm font-semibold text-white transition hover:bg-sky-400 disabled:opacity-50"
        >
          Kirim Kode OTP ke WhatsApp
        </button>

        <div class="border-t border-white/10 pt-4 text-center text-xs text-slate-400">
          Sudah punya akun?{" "}
          <a href="/masuk" class="font-semibold text-sky-400 hover:text-sky-300">
            Masuk di sini
          </a>
        </div>
      </form>

      {/* Step 2: Verifikasi OTP */}
      <form
        id="register-step2"
        class="hidden space-y-4 rounded-2xl border border-white/10 bg-slate-900/90 p-6 shadow-xl"
      >
        <div class="flex items-start gap-3 rounded-xl border border-sky-400/25 bg-sky-500/10 p-3.5 text-xs text-sky-100">
          <ShieldCheck className="mt-0.5 h-4 w-4 shrink-0 text-sky-400" />
          <div id="otp-info-text">
            Kode OTP 6 digit telah dikirim ke WhatsApp Anda. Berlaku selama 10 menit.
          </div>
        </div>

        <div class="space-y-1.5">
          <label for="otp-code" class="block text-xs font-medium text-slate-300">
            Masukkan 6 Digit Kode OTP *
          </label>
          <input
            id="otp-code"
            name="code"
            type="text"
            inputmode="numeric"
            maxlength="6"
            required
            placeholder="123456"
            class="w-full rounded-xl border border-white/10 bg-slate-950 px-3 py-3 text-center font-mono text-2xl tracking-[0.4em] text-white placeholder-slate-600 focus:border-sky-400 focus:outline-none"
          />
        </div>

        <div
          id="verify-error"
          class="hidden rounded-xl border border-red-500/30 bg-red-500/10 px-3.5 py-2.5 text-xs text-red-200"
        >
        </div>

        <div class="flex gap-2">
          <button
            id="btn-back-step1"
            type="button"
            class="rounded-xl border border-white/15 px-4 py-2.5 text-xs font-medium text-slate-300 hover:bg-white/5"
          >
            Ubah Data
          </button>
          <button
            id="btn-verify-otp"
            type="submit"
            class="flex-1 rounded-xl bg-emerald-500 py-2.5 text-sm font-semibold text-white transition hover:bg-emerald-400 disabled:opacity-50"
          >
            Verifikasi &amp; Buat Undangan
          </button>
        </div>
      </form>

      <div class="text-center">
        <a
          href="/"
          class="inline-flex items-center gap-1.5 text-xs text-slate-400 hover:text-white"
        >
          <ArrowLeft className="h-3.5 w-3.5" />
          Kembali ke Beranda
        </a>
      </div>
    </div>
  </div>
</Layout>

<script>
  const step1 = document.getElementById("register-step1") as HTMLFormElement | null;
  const step2 = document.getElementById("register-step2") as HTMLFormElement | null;
  const brideInput = document.getElementById("brideNickname") as HTMLInputElement | null;
  const groomInput = document.getElementById("groomNickname") as HTMLInputElement | null;
  const slugInput = document.getElementById("slug") as HTMLInputElement | null;
  const regError = document.getElementById("reg-error");
  const verifyError = document.getElementById("verify-error");
  const otpInfoText = document.getElementById("otp-info-text");
  const btnSendOtp = document.getElementById("btn-send-otp") as HTMLButtonElement | null;
  const btnVerifyOtp = document.getElementById("btn-verify-otp") as HTMLButtonElement | null;
  const btnBackStep1 = document.getElementById("btn-back-step1");

  let slugTouched = false;
  let pendingPhone = "";

  slugInput?.addEventListener("input", () => {
    slugTouched = true;
  });

  const autoSlug = () => {
    if (slugTouched || !slugInput) return;
    const b = (brideInput?.value || "").trim().toLowerCase();
    const g = (groomInput?.value || "").trim().toLowerCase();
    if (!b && !g) return;
    slugInput.value = `${b}-${g}`
      .replace(/[^a-z0-9-]+/g, "-")
      .replace(/-+/g, "-")
      .replace(/^-|-$/g, "");
  };
  brideInput?.addEventListener("input", autoSlug);
  groomInput?.addEventListener("input", autoSlug);

  step1?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!regError || !btnSendOtp) return;
    regError.classList.add("hidden");
    btnSendOtp.disabled = true;
    btnSendOtp.textContent = "Mengirim OTP via WhatsApp...";

    const fd = new FormData(step1);
    try {
      const res = await fetch("/api/auth/register-otp", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(Object.fromEntries(fd.entries())),
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.success) {
        pendingPhone = data.phone;
        if (otpInfoText) {
          otpInfoText.textContent = data.devOtp
            ? `Mode pengembangan (WA Platform belum diatur): gunakan kode OTP ${data.devOtp} untuk nomor ${data.phone}.`
            : `Kode OTP 6 digit telah dikirim ke WhatsApp ${data.phone}. Berlaku ${data.expiresInMinutes} menit.`;
        }
        step1.classList.add("hidden");
        step2?.classList.remove("hidden");
        (document.getElementById("otp-code") as HTMLInputElement | null)?.focus();
        return;
      }
      regError.textContent = data.error || "Gagal mengirim OTP pendaftaran.";
      regError.classList.remove("hidden");
    } catch {
      regError.textContent = "Gagal terhubung ke server.";
      regError.classList.remove("hidden");
    } finally {
      btnSendOtp.disabled = false;
      btnSendOtp.textContent = "Kirim Kode OTP ke WhatsApp";
    }
  });

  btnBackStep1?.addEventListener("click", () => {
    step2?.classList.add("hidden");
    step1?.classList.remove("hidden");
  });

  step2?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!verifyError || !btnVerifyOtp) return;
    verifyError.classList.add("hidden");
    btnVerifyOtp.disabled = true;
    btnVerifyOtp.textContent = "Memverifikasi...";

    const code = (document.getElementById("otp-code") as HTMLInputElement | null)?.value || "";
    try {
      const res = await fetch("/api/auth/register-verify", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        credentials: "include",
        body: JSON.stringify({ phone: pendingPhone, code }),
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.success) {
        window.location.href = data.redirectTo || "/admin";
        return;
      }
      verifyError.textContent = data.error || "Verifikasi OTP gagal.";
      verifyError.classList.remove("hidden");
    } catch {
      verifyError.textContent = "Gagal terhubung ke server.";
      verifyError.classList.remove("hidden");
    } finally {
      btnVerifyOtp.disabled = false;
      btnVerifyOtp.textContent = "Verifikasi & Buat Undangan";
    }
  });
</script>
