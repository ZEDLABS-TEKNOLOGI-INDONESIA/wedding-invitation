---
import GuestManager from "../components/GuestManager";
import Layout from "../layouts/Layout.astro";
import { isAdminAuthenticated } from "../lib/auth";

Astro.response.headers.set("Cache-Control", "no-store");

if (!isAdminAuthenticated(Astro.cookies)) {
  return Astro.redirect("/admin");
}
---

<Layout title="Scanner Check-In Tamu" noindex={true}>
  <main
    class="min-h-screen bg-slate-50 px-4 py-10 text-slate-800 dark:bg-slate-900 dark:text-slate-200"
  >
    <div class="mx-auto max-w-5xl space-y-6">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <h1 class="font-serif text-3xl font-bold italic dark:text-white">
            Buku Tamu & Check-In Hari H
          </h1>
          <p class="text-sm text-slate-500 dark:text-slate-400">
            Pindai QR Code tamu atau cari nama untuk mencatat kehadiran
          </p>
        </div>
        <a
          href="/admin"
          class="rounded-full border border-slate-200 bg-white px-5 py-2 text-xs font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"
        >
          &larr; Kembali ke Dashboard
        </a>
      </div>

      <div
        class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm md:p-8 dark:border-slate-700 dark:bg-slate-800"
      >
        <GuestManager
          client:load
          siteUrl={Astro.site?.toString() || "https://wedding.zedlabs.id"}
          initialSubTab="scanner"
        />
      </div>
    </div>
  </main>
</Layout>
