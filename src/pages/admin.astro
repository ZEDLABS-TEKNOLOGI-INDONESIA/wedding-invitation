---
import { ExternalLink, LogOut, Moon, Sun } from "lucide-react";
import AdminDashboard from "../components/Admin/AdminDashboard";
import Layout from "../layouts/Layout.astro";
import {
  createAdminSession,
  destroyAdminSession,
  getConfiguredAdminPassword,
  isAdminAuthenticated,
  verifyAdminPassword,
} from "../lib/auth";
import db from "../lib/db";
import { checkRateLimit, getClientIp } from "../lib/rateLimit";

const JSON_HEADERS = {
  "Content-Type": "application/json",
  "Cache-Control": "no-store",
};

if (Astro.request.method === "POST") {
  const contentType = Astro.request.headers.get("content-type") || "";

  if (contentType.includes("application/json")) {
    let body: Record<string, unknown> = {};
    try {
      body = (await Astro.request.json()) as Record<string, unknown>;
    } catch {
      return new Response(
        JSON.stringify({ success: false, error: "Request tidak valid." }),
        { status: 400, headers: JSON_HEADERS }
      );
    }

    const action = body.action;

    if (action === "login") {
      const ip = getClientIp(Astro.request, Astro.clientAddress);
      if (!checkRateLimit(`login:${ip}`, 5, 15 * 60 * 1000)) {
        return new Response(
          JSON.stringify({
            success: false,
            error: "Terlalu banyak percobaan login. Coba lagi dalam 15 menit.",
          }),
          { status: 429, headers: JSON_HEADERS }
        );
      }

      if (!getConfiguredAdminPassword()) {
        return new Response(
          JSON.stringify({
            success: false,
            error: "ADMIN_PASSWORD belum dikonfigurasi di server.",
          }),
          { status: 503, headers: JSON_HEADERS }
        );
      }

      const credential =
        typeof body.credential === "string" ? body.credential : "";
      if (verifyAdminPassword(credential)) {
        createAdminSession(Astro.cookies, Astro.request);
        return new Response(JSON.stringify({ success: true }), {
          status: 200,
          headers: JSON_HEADERS,
        });
      } else {
        return new Response(
          JSON.stringify({
            success: false,
            error: "Kredensial tidak valid. Silakan coba lagi.",
          }),
          { status: 401, headers: JSON_HEADERS }
        );
      }
    }

    if (action === "logout") {
      destroyAdminSession(Astro.cookies);
      return new Response(JSON.stringify({ success: true }), {
        status: 200,
        headers: JSON_HEADERS,
      });
    }
  }
}

Astro.response.headers.set("Cache-Control", "no-store");

const isAuthenticated = isAdminAuthenticated(Astro.cookies);
let rsvps = [],
  wishes = [];

if (isAuthenticated) {
  rsvps = db.prepare("SELECT * FROM rsvps ORDER BY created_at DESC").all();
  wishes = db.prepare("SELECT * FROM wishes ORDER BY created_at DESC").all();
}
---

<Layout title="Admin Dashboard" noindex={true}>
  <main
    class="min-h-screen bg-slate-50 text-slate-800 dark:bg-slate-900 dark:text-slate-200"
  >
    {
      !isAuthenticated ? (
        <div class="flex h-screen w-full items-center justify-center px-4">
          <div class="w-full max-w-md space-y-8 rounded-2xl bg-white p-10 shadow-xl dark:bg-slate-800">
            <div class="text-center">
              <h1 class="font-serif text-3xl font-bold text-slate-900 italic dark:text-white">
                Admin Access
              </h1>
            </div>
            <div
              id="login-error"
              role="alert"
              class="hidden rounded-lg bg-red-50 px-4 py-3 text-sm font-medium text-red-600 dark:bg-red-900/20 dark:text-red-400"
            >
              Kredensial tidak valid. Silakan coba lagi.
            </div>
            <form id="login-form" class="mt-8 space-y-6">
              <div>
                <label
                  for="admin-credential"
                  class="sr-only"
                >
                  Password Admin
                </label>
                <input
                  id="admin-credential"
                  name="password"
                  type="password"
                  required
                  autocomplete="current-password"
                  class="block w-full rounded-lg border border-slate-300 bg-slate-50 p-4 text-slate-900 dark:border-slate-600 dark:bg-slate-700 dark:text-white"
                  placeholder="Masukkan akses kunci..."
                />
              </div>
              <button
                id="login-btn"
                type="submit"
                class="w-full rounded-lg bg-slate-900 px-4 py-4 text-sm font-bold text-white hover:bg-slate-800 disabled:opacity-50 dark:bg-blue-600"
              >
                MASUK
              </button>
            </form>
          </div>
        </div>
      ) : (
        <div class="container mx-auto max-w-7xl px-4 py-10">
          <div class="mb-10 flex flex-col items-center justify-between gap-4 md:flex-row">
            <div>
              <h1 class="font-serif text-3xl font-bold italic md:text-4xl">
                Wedding Dashboard
              </h1>
              <p class="text-sm text-slate-500 dark:text-slate-400">
                Selamat datang, Admin
              </p>
            </div>
            <div class="flex flex-wrap items-center gap-3">
              <a
                href="/"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-2 rounded-full border border-slate-200 bg-white px-5 py-2 text-xs font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"
              >
                <ExternalLink className="h-4 w-4" /> LIHAT UNDANGAN
              </a>
              <button
                id="admin-theme-toggle"
                type="button"
                aria-label="Ubah tema terang atau gelap"
                class="flex items-center gap-2 rounded-full border border-slate-200 bg-white px-4 py-2 text-xs font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"
              >
                <Moon className="h-4 w-4 dark:hidden" />
                <Sun className="hidden h-4 w-4 dark:inline" />
                <span class="dark:hidden">GELAP</span>
                <span class="hidden dark:inline">TERANG</span>
              </button>
              <button
                id="logout-btn"
                type="button"
                class="flex items-center gap-2 rounded-full border border-red-200 bg-red-50 px-6 py-2 text-xs font-bold text-red-600 hover:bg-red-100 dark:border-red-900/50 dark:bg-red-900/20 dark:text-red-400"
              >
                <LogOut className="h-4 w-4" /> LOGOUT
              </button>
            </div>
          </div>

          <AdminDashboard
            client:load
            initialRsvps={rsvps}
            initialWishes={wishes}
            siteUrl={Astro.site?.toString() || "https://wedding.zedlabs.id"}
          />
        </div>
      )
    }
  </main>

  <script>
    const loginForm = document.getElementById("login-form");
    const loginBtn = document.getElementById("login-btn");
    const credentialInput = document.getElementById(
      "admin-credential"
    ) as HTMLInputElement | null;
    const loginError = document.getElementById("login-error");

    if (loginForm && loginBtn && credentialInput) {
      loginForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        const val = credentialInput.value;
        if (!val) return;

        if (loginError) loginError.classList.add("hidden");
        loginBtn.textContent = "Memverifikasi...";
        loginBtn.setAttribute("disabled", "true");

        try {
          const res = await fetch("/admin", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ action: "login", credential: val }),
          });

          if (res.ok) {
            window.location.reload();
          } else {
            let msg = "Kredensial tidak valid. Silakan coba lagi.";
            try {
              const payload = await res.json();
              if (payload?.error) msg = payload.error;
            } catch {
              // ignore JSON parse errors
            }
            if (loginError) {
              loginError.textContent = msg;
              loginError.classList.remove("hidden");
            }
            loginBtn.textContent = "MASUK";
            loginBtn.removeAttribute("disabled");
          }
        } catch {
          if (loginError) {
            loginError.textContent = "Gagal terhubung ke server.";
            loginError.classList.remove("hidden");
          }
          loginBtn.textContent = "MASUK";
          loginBtn.removeAttribute("disabled");
        }
      });
    }

    const themeToggleBtn = document.getElementById("admin-theme-toggle");
    if (themeToggleBtn) {
      themeToggleBtn.addEventListener("click", () => {
        const isDark = document.documentElement.classList.toggle("dark");
        localStorage.setItem("theme", isDark ? "dark" : "light");
      });
    }

    const logoutBtn = document.getElementById("logout-btn");
    if (logoutBtn) {
      logoutBtn.addEventListener("click", async () => {
        await fetch("/admin", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ action: "logout" }),
        });
        window.location.reload();
      });
    }
  </script>
</Layout>
