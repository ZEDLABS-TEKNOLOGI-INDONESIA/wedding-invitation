---
import AdminDashboard from "../components/Admin/AdminDashboard";
import Layout from "../layouts/Layout.astro";
import { destroyAdminSession, getAuthSession } from "../lib/auth";
import db, { getPublicConfig } from "../lib/db";

const JSON_HEADERS = {
  "Content-Type": "application/json",
  "Cache-Control": "no-store",
};

if (Astro.request.method === "POST") {
  const contentType = Astro.request.headers.get("content-type") || "";
  if (contentType.includes("application/json")) {
    const body = (await Astro.request.json().catch(() => ({}))) as Record<
      string,
      unknown
    >;
    if (body.action === "logout") {
      destroyAdminSession(Astro.cookies);
      return new Response(JSON.stringify({ success: true }), {
        status: 200,
        headers: JSON_HEADERS,
      });
    }
  }
}

Astro.response.headers.set("Cache-Control", "no-store");

const session = getAuthSession(Astro.cookies);
if (!session) {
  return Astro.redirect("/masuk");
}

const publicCfg = getPublicConfig(session.weddingId);
const coupleLabel =
  publicCfg.BRIDE_NICKNAME && publicCfg.GROOM_NICKNAME
    ? `${publicCfg.BRIDE_NICKNAME} & ${publicCfg.GROOM_NICKNAME}`
    : session.weddingTitle || "Wedding Management";

const rsvps = db
  .prepare("SELECT * FROM rsvps WHERE wedding_id = ? ORDER BY created_at DESC")
  .all(session.weddingId);
const wishes = db
  .prepare("SELECT * FROM wishes WHERE wedding_id = ? ORDER BY created_at DESC")
  .all(session.weddingId);

const origin = (
  Astro.site?.toString() ||
  Astro.url.origin ||
  "https://wedding.zedlabs.id"
).replace(/\/+$/, "");
const publicPath = session.isDemo ? "/demo" : `/u/${session.weddingSlug}`;
const tenantSiteUrl = `${origin}${publicPath}`;
---

<Layout title={`Admin | ${coupleLabel}`} noindex={true}>
  <div class="admin-shell min-h-dvh">
    <AdminDashboard
      client:load
      initialRsvps={rsvps as any}
      initialWishes={wishes as any}
      siteUrl={tenantSiteUrl}
      coupleLabel={coupleLabel}
      publicInvitationPath={publicPath}
      currentUser={{
        username: session.username,
        fullName: session.fullName,
        role: session.role,
        avatarUrl: session.avatarUrl,
      }}
    />
  </div>
</Layout>
