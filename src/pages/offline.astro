---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Sedang offline | Wedding Management"
  description="Koneksi internet tidak tersedia. Sambungkan kembali perangkat Anda untuk memuat halaman."
  noindex={true}
>
  <main class="admin-shell is-public flex min-h-dvh items-center justify-center bg-(--adm-bg-primary) px-6">
    <div class="max-w-md text-center">
      <p class="font-mono text-sm font-semibold tracking-wider text-(--adm-accent) uppercase">
        Offline
      </p>
      <h1 class="mt-3 text-xl font-semibold text-(--adm-text-primary)">
        Koneksi internet terputus
      </h1>
      <p class="mt-2 text-sm text-(--adm-text-secondary)">
        Halaman ini belum tersimpan di perangkat Anda. Periksa koneksi lalu muat ulang halaman.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-2">
        <button id="btn-retry-offline" type="button" class="adm-btn adm-btn-primary">
          Muat ulang
        </button>
        <a href="/" class="adm-btn adm-btn-secondary">
          Ke beranda
        </a>
      </div>
    </div>
  </main>

  <script>
    document.getElementById("btn-retry-offline")?.addEventListener("click", () => {
      window.location.reload();
    });
    window.addEventListener("online", () => {
      window.location.reload();
    });
  </script>
</Layout>
