</style>

<script>
  const slider = document.getElementById("calc-slider") as HTMLInputElement | null;
  const priceEl = document.getElementById("calc-price");
  const descEl = document.getElementById("calc-desc");
  const countEl = document.getElementById("calc-count-label");

  function updateCalc(total: number) {
    if (!priceEl || !descEl || !countEl) return;
    countEl.textContent = `${total.toLocaleString("id-ID")} tamu`;
    if (total <= 200) {
      priceEl.textContent = "Rp0";
      descEl.textContent = "Masuk dalam kuota gratis (maksimal 200 tamu).";
      return;
    }
    const rawAdded = total - 200;
    const amount = Math.max(50000, rawAdded * 200);
    const granted = Math.max(250, rawAdded);
    priceEl.textContent = `Rp${amount.toLocaleString("id-ID")}`;
    descEl.textContent = `200 tamu gratis + ${granted.toLocaleString("id-ID")} kuota tambahan (total ${(200 + granted).toLocaleString("id-ID")} tamu).`;
  }

  slider?.addEventListener("input", () => {
    updateCalc(Number(slider.value || 200));
  });

  document.querySelectorAll<HTMLButtonElement>(".calc-preset").forEach((btn) => {
    btn.addEventListener("click", () => {
      const v = Number(btn.dataset.val || 200);
      if (slider) slider.value = String(v);
      updateCalc(v);
    });
  });
</script>
