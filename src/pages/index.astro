---
import {
  Check,
  ClipboardList,
  ExternalLink,
  MessageSquare,
  Palette,
  QrCode,
  Shield,
  Users,
} from "lucide-react";
import HeroPreviewIsland from "../components/public/HeroPreviewIsland";
import SliderPasangan, {
  type PasanganSlider,
} from "../components/public/SliderPasangan.astro";
import PublicLayout from "../layouts/PublicLayout.astro";
import { getAuthSession } from "../lib/auth";
import {
  FREE_GUEST_QUOTA,
  MIN_PAYMENT_AMOUNT,
  PRICE_PER_GUEST,
} from "../lib/billing";
import db, { getPlatformConfig } from "../lib/db";
import { ensureReminderSchedulerStarted } from "../lib/reminderScheduler";

ensureReminderSchedulerStarted();
const session = getAuthSession(Astro.cookies);
const platformCfg = getPlatformConfig();
const platformName = platformCfg.PLATFORM_NAME || "Wedding Management";
const dashboardHref = session?.role === "superadmin" ? "/superadmin" : "/admin";

const activeWeddingRows = db
  .prepare(
    "SELECT id, slug, is_demo FROM weddings WHERE status = 'active' ORDER BY is_demo ASC, id DESC LIMIT 24",
  )
  .all() as { id: number; slug: string; is_demo: number }[];

const totalActiveWeddings = (
  db
    .prepare("SELECT COUNT(*) as c FROM weddings WHERE status = 'active'")
    .get() as { c: number }
).c;

const coupleConfigStmt = db.prepare(
  "SELECT key, value FROM wedding_config WHERE wedding_id = ? AND key IN ('BRIDE_NICKNAME', 'GROOM_NICKNAME', 'BRIDE_IMAGE', 'GROOM_IMAGE')",
);

const allActiveCouples: PasanganSlider[] = activeWeddingRows.map((w) => {
  const cfgRows = coupleConfigStmt.all(w.id) as { key: string; value: string }[];
  const cfg = Object.fromEntries(cfgRows.map((r) => [r.key, r.value]));
  return {
    id: w.id,
    slug: w.slug,
    isDemo: w.is_demo === 1,
    brideName: (cfg.BRIDE_NICKNAME || "Mempelai Wanita").trim(),
    groomName: (cfg.GROOM_NICKNAME || "Mempelai Pria").trim(),
    brideImage: (cfg.BRIDE_IMAGE || "").trim(),
    groomImage: (cfg.GROOM_IMAGE || "").trim(),
  };
});

const nonDemoCouples = allActiveCouples.filter((c) => !c.isDemo);
const pasanganSlider = nonDemoCouples.length > 0 ? nonDemoCouples : allActiveCouples;

const langkah = [
  {
    nomor: "01",
    judul: "Daftar & verifikasi OTP WhatsApp",
    isi: "Pilih alamat URL unik (/u/nama-pasangan), buat username & password, lalu verifikasi kode OTP 6 digit yang dikirim langsung ke WhatsApp Anda.",
    tautan: session
      ? { href: dashboardHref, label: "Buka dashboard" }
      : { href: "/daftar", label: "Mulai pendaftaran" },
  },
  {
    nomor: "02",
    judul: "Atur undangan & undang pasangan",
    isi: "Pilih 1 dari 6 tema publik, lengkapi jadwal & lokasi peta, daftarkan 1 akun pendamping untuk pasangan, dan susun persiapan nikah bersama.",
    tautan: { href: "/dokumentasi", label: "Baca dokumentasi fitur" },
  },
  {
    nomor: "03",
    judul: "Impor tamu, kirim WA & check-in Hari H",
    isi: "Gratis hingga 200 tamu pertama. Kirim undangan personal (teks + PDF 4 halaman + QR) lewat WhatsApp Gateway dan pindai kehadiran tamu di Hari H.",
    tautan: { href: "/layanan-mandiri", label: "Lihat panduan mandiri" },
  },
];

const tautanPanduan = [
  {
    href: "/dokumentasi",
    judul: "Dokumentasi Fitur",
    ket: "Undangan, 6 modul nikah, WA Gateway & QR",
  },
  {
    href: "/layanan-mandiri",
    judul: "Panduan Layanan Mandiri",
    ket: "Alur daftar, akun pasangan & upgrade kuota",
  },
  {
    href: "/demo",
    judul: "Demo Undangan",
    ket: "Pratinjau langsung tampilan undangan tamu",
  },
  {
    href: "/faq",
    judul: "Pertanyaan Umum (FAQ)",
    ket: "Jawaban cepat isolasi data, kuota & OTP",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      name: "ZEDLABS Teknologi Indonesia",
      url: "https://zedlabs.id",
    },
    {
      "@type": "WebSite",
      name: `${platformName} — ZEDLABS`,
      url: "https://wedding.zedlabs.id/",
      inLanguage: "id-ID",
    },
    {
      "@type": "SoftwareApplication",
      name: `${platformName} — ZEDLABS`,
      applicationCategory: "LifestyleApplication",
      operatingSystem: "Web",
      url: "https://wedding.zedlabs.id/",
      description:
        "Platform undangan pernikahan digital, RSVP, check-in QR, dan manajemen persiapan nikah terisolasi per pasangan dengan integrasi WhatsApp Gateway.",
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "IDR",
        description: "Gratis hingga 200 kontak tamu; Rp200/tamu tambahan (min. Rp50.000).",
      },
      provider: {
        "@type": "Organization",
        name: "ZEDLABS Teknologi Indonesia",
        url: "https://zedlabs.id",
      },
    },
  ],
};
---

<PublicLayout title={platformName}>
  {/* Centered Editorial Hero (1:1 gaya whatsapp-service) */}
  <section class="pub-hero-main border-b border-(--adm-border) bg-(--adm-bg-primary)">
    <div class="mx-auto max-w-7xl px-4 pt-14 pb-16 sm:px-6 sm:pt-20 sm:pb-20">
      <div class="mx-auto max-w-3xl text-center">
        <a
          href="/dokumentasi"
          class="inline-flex items-center gap-2 rounded-full border border-(--adm-info-border) bg-(--adm-bg-secondary) px-3.5 py-1 text-xs font-medium text-(--adm-accent) transition-colors hover:bg-(--adm-accent-soft)"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-(--adm-accent)" aria-hidden="true"></span>
          <span>Platform Undangan Digital &amp; Manajemen Pernikahan</span>
          <span aria-hidden="true">&rarr;</span>
        </a>

        <h1 class="mt-5 text-(length:--adm-text-hero) leading-[1.1] font-bold tracking-tight text-(--adm-text-primary)">
          Undangan digital &amp; persiapan nikah,{" "}
          <span class="text-(--adm-accent)">dikelola berdua dari satu tempat.</span>
        </h1>

        <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-(--adm-text-secondary) sm:text-lg">
          Buat undangan ber-URL unik terisolasi per pasangan, rencanakan anggaran hingga berkas KUA
          bersama, kirim undangan lewat WhatsApp Gateway, dan catat kehadiran tamu dengan QR
          Check-In.
        </p>

        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          {session ? (
            <a href={dashboardHref} class="adm-btn adm-btn-primary adm-btn-lg">
              Masuk ke Dashboard
            </a>
          ) : (
            <a href="/daftar" class="adm-btn adm-btn-primary adm-btn-lg">
              Buat Undangan Gratis
            </a>
          )}
          <a href="/demo" class="adm-btn adm-btn-secondary adm-btn-lg">
            <ExternalLink className="h-4 w-4" aria-hidden="true" />
            Lihat Demo Undangan
          </a>
        </div>

        <ul class="mt-6 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-xs text-(--adm-text-secondary)">
          <li class="inline-flex items-center gap-1.5">
            <Check className="h-3.5 w-3.5 text-(--adm-accent)" aria-hidden="true" />
            Gratis hingga {FREE_GUEST_QUOTA} tamu
          </li>
          <li class="inline-flex items-center gap-1.5">
            <Check className="h-3.5 w-3.5 text-(--adm-accent)" aria-hidden="true" />
            Isolasi penuh per pasangan
          </li>
          <li class="inline-flex items-center gap-1.5">
            <Check className="h-3.5 w-3.5 text-(--adm-accent)" aria-hidden="true" />
            Terintegrasi WhatsApp Gateway
          </li>
        </ul>
      </div>

      <div class="mx-auto mt-10 max-w-4xl">
        <HeroPreviewIsland client:load />
      </div>
    </div>
  </section>

  {/* Ringkasan Metrik & Spesifikasi Platform (1:1 gaya StatistikPublik whatsapp-service) */}
  <section
    class="border-b border-(--adm-border) bg-(--adm-bg-secondary)"
    aria-labelledby="judul-spesifikasi"
  >
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6">
      <div class="mb-5 flex flex-wrap items-center justify-between gap-2">
        <h2
          id="judul-spesifikasi"
          class="text-xs font-semibold tracking-wider text-(--adm-text-secondary) uppercase"
        >
          Spesifikasi &amp; statistik platform
        </h2>
        <span class="inline-flex items-center gap-1.5 rounded-full border border-(--adm-border) bg-(--adm-bg-primary) px-2.5 py-0.5 text-[11px] font-medium text-(--adm-text-secondary)">
          <span class="h-1.5 w-1.5 rounded-full bg-(--adm-accent)" aria-hidden="true"></span>
          Data aktual database server
        </span>
      </div>

      <dl class="grid grid-cols-2 divide-y divide-(--adm-border) overflow-hidden rounded-xl border border-(--adm-border) bg-(--adm-bg-primary) lg:grid-cols-4 lg:divide-x lg:divide-y-0">
        <div class="flex flex-col gap-1 p-5">
          <dt class="text-xs font-medium text-(--adm-text-secondary)">Ruang undangan aktif</dt>
          <dd class="text-2xl font-bold tracking-tight text-(--adm-text-primary) tabular-nums sm:text-3xl">
            {totalActiveWeddings.toLocaleString("id-ID")}
          </dd>
          <p class="text-[11px] text-(--adm-text-muted)">Terisolasi penuh per pasangan</p>
        </div>

        <div class="flex flex-col gap-1 p-5">
          <dt class="text-xs font-medium text-(--adm-text-secondary)">Kuota tamu gratis</dt>
          <dd class="text-2xl font-bold tracking-tight text-(--adm-accent) tabular-nums sm:text-3xl">
            {FREE_GUEST_QUOTA}
          </dd>
          <p class="text-[11px] text-(--adm-text-muted)">
            Rp{PRICE_PER_GUEST}/tamu tambahan (min. Rp{(MIN_PAYMENT_AMOUNT / 1000).toLocaleString("id-ID")}rb)
          </p>
        </div>

        <div class="flex flex-col gap-1 p-5">
          <dt class="text-xs font-medium text-(--adm-text-secondary)">Tema undangan</dt>
          <dd class="text-2xl font-bold tracking-tight text-(--adm-text-primary) tabular-nums sm:text-3xl">
            6 Tema
          </dd>
          <p class="text-[11px] text-(--adm-text-muted)">
            Ocean, Sage, Blush, Maroon, Gold, Lavender
          </p>
        </div>

        <div class="flex flex-col gap-1 p-5">
          <dt class="text-xs font-medium text-(--adm-text-secondary)">Modul manajemen nikah</dt>
          <dd class="text-2xl font-bold tracking-tight text-(--adm-accent) tabular-nums sm:text-3xl">
            6 Modul
          </dd>
          <p class="text-[11px] text-(--adm-text-muted)">
            To-Do, Anggaran, Tabungan, KUA, Jurnal, Fikih
          </p>
        </div>
      </dl>
    </div>
  </section>

  {/* Pasangan Aktif dengan Foto Circle Bertumpuk (1:1 posisi SliderInstansi whatsapp-service) */}
  <SliderPasangan pasangan={pasanganSlider} />

  {/* Asymmetric 6-Column Bento Feature Grid (1:1 gaya whatsapp-service) */}
  <section
    id="fitur"
    class="mx-auto max-w-7xl scroll-mt-16 px-4 py-16 sm:px-6 sm:py-20"
    aria-labelledby="judul-fitur"
  >
    <div class="mx-auto mb-12 max-w-2xl text-center">
      <p class="text-xs font-semibold tracking-wider text-(--adm-accent) uppercase">
        Kapabilitas platform
      </p>
      <h2
        id="judul-fitur"
        class="mt-1.5 text-(length:--adm-text-2xl) font-bold tracking-tight text-(--adm-text-primary)"
      >
        Seluruh kebutuhan undangan dan persiapan nikah dalam satu panel
      </h2>
      <p class="mt-2.5 text-sm leading-relaxed text-(--adm-text-secondary) sm:text-base">
        Seluruh fitur langsung aktif begitu Anda mendaftar — dari tampilan undangan hingga
        manajemen persiapan nikah dan check-in Hari H.
      </p>
    </div>

    <div class="grid gap-4 md:grid-cols-6">
      {/* Bento 1 (wide): Undangan Digital & 6 Tema */}
      <article class="flex flex-col justify-between gap-5 rounded-xl border border-(--adm-border) bg-(--adm-bg-secondary) p-6 md:col-span-4">
        <div class="space-y-2">
          <div class="inline-flex items-center gap-2 text-xs font-semibold text-(--adm-accent)">
            <Palette className="h-4 w-4" aria-hidden="true" />
            Undangan Digital Responsif
          </div>
          <h3 class="text-base font-semibold text-(--adm-text-primary)">
            6 Tema Warna Publik, Mode Gelap &amp; Animasi Latar Pilihan
          </h3>
          <p class="text-sm leading-relaxed text-(--adm-text-secondary)">
            Halaman undangan khusus di <code class="adm-kbd-code">/u/nama-pasangan</code> lengkap
            dengan sampul personal, profil mempelai, hitung mundur, jadwal akad/resepsi, peta
            lokasi, galeri foto, kisah cinta, musik latar, amplop tanda kasih, RSVP, dan buku
            ucapan.
          </p>
        </div>
        <div class="flex flex-wrap gap-2 border-t border-(--adm-border) pt-3">
          {["Ocean", "Sage", "Blush", "Maroon", "Gold", "Lavender"].map((t) => (
            <code class="adm-kbd-code">{t}</code>
          ))}
        </div>
      </article>

      {/* Bento 2 (narrow): Isolasi Data */}
      <article class="flex flex-col justify-between gap-5 rounded-xl border border-(--adm-border) bg-(--adm-bg-secondary) p-6 md:col-span-2">
        <div class="space-y-2">
          <div class="inline-flex items-center gap-2 text-xs font-semibold text-(--adm-accent)">
            <Shield className="h-4 w-4" aria-hidden="true" />
            Isolasi Data
          </div>
          <h3 class="text-base font-semibold text-(--adm-text-primary)">
            Terpisah Penuh per Pasangan
          </h3>
          <p class="text-sm leading-relaxed text-(--adm-text-secondary)">
            Daftar tamu, RSVP, ucapan, anggaran, tabungan, hingga sesi WhatsApp terpisah ketat
            untuk setiap ruang pasangan tanpa pernah bercampur.
          </p>
        </div>
        <div class="rounded-lg border border-(--adm-border) bg-(--adm-bg-primary) px-3 py-2 font-mono text-[11px] text-(--adm-text-secondary)">
          /u/nama-pasangan &middot; Ruang Privat
        </div>
      </article>

      {/* Bento 3 (narrow): Akun Berdua */}
      <article class="flex flex-col justify-between gap-5 rounded-xl border border-(--adm-border) bg-(--adm-bg-secondary) p-6 md:col-span-2">
        <div class="space-y-2">
          <div class="inline-flex items-center gap-2 text-xs font-semibold text-(--adm-accent)">
            <Users className="h-4 w-4" aria-hidden="true" />
            Kolaborasi Pasangan
          </div>
          <h3 class="text-base font-semibold text-(--adm-text-primary)">
            Akun Berdua (Suami &amp; Istri)
          </h3>
          <p class="text-sm leading-relaxed text-(--adm-text-secondary)">
            Pemilik utama dapat mendaftarkan 1 akun pendamping dengan username, password, dan nomor
            WhatsApp OTP masing-masing.
          </p>
        </div>
        <div class="flex flex-wrap gap-1.5">
          <span class="adm-badge adm-badge-accent">Pemilik Utama</span>
          <span class="adm-badge adm-badge-success">Akun Pasangan</span>
        </div>
      </article>

      {/* Bento 4 (wide): 6 Modul Manajemen Pernikahan */}
      <article class="flex flex-col justify-between gap-5 rounded-xl border border-(--adm-border) bg-(--adm-bg-secondary) p-6 md:col-span-4">
        <div class="space-y-2">
          <div class="inline-flex items-center gap-2 text-xs font-semibold text-(--adm-accent)">
            <ClipboardList className="h-4 w-4" aria-hidden="true" />
            Manajemen Pernikahan
          </div>
          <h3 class="text-base font-semibold text-(--adm-text-primary)">
            6 Modul Persiapan Nikah, Berkas KUA &amp; Fikih Munakahat
          </h3>
          <p class="text-sm leading-relaxed text-(--adm-text-secondary)">
            Susun persiapan nikah secara terstruktur bersama pasangan tanpa spreadsheet terpisah —
            termasuk daftar berkas KUA mengacu PMA No. 30 Tahun 2024, SIMKAH, dan Elsimil.
          </p>
        </div>
        <div class="grid gap-2 border-t border-(--adm-border) pt-3 text-xs sm:grid-cols-3">
          <div class="rounded-md border border-(--adm-border) bg-(--adm-bg-primary) px-3 py-2">
            <span class="block font-semibold text-(--adm-text-primary)">To-Do &amp; Jurnal</span>
            <span class="text-(--adm-text-muted)">H-12 bulan s.d. Hari H</span>
          </div>
          <div class="rounded-md border border-(--adm-border) bg-(--adm-bg-primary) px-3 py-2">
            <span class="block font-semibold text-(--adm-text-primary)">Anggaran &amp; Tabungan</span>
            <span class="text-(--adm-text-muted)">Vendor, DP &amp; target halal</span>
          </div>
          <div class="rounded-md border border-(--adm-border) bg-(--adm-bg-primary) px-3 py-2">
            <span class="block font-semibold text-(--adm-text-primary)">KUA &amp; Fikih Nikah</span>
            <span class="text-(--adm-text-muted)">Mahar, seserahan &amp; berkas</span>
          </div>
        </div>
      </article>

      {/* Bento 5 (half): WhatsApp Gateway & PDF 4 Halaman */}
      <article class="flex flex-col justify-between gap-4 rounded-xl border border-(--adm-border) bg-(--adm-bg-secondary) p-6 md:col-span-3">
        <div class="space-y-2">
          <div class="inline-flex items-center gap-2 text-xs font-semibold text-(--adm-accent)">
            <MessageSquare className="h-4 w-4" aria-hidden="true" />
            WhatsApp Gateway &amp; Stationery
          </div>
          <h3 class="text-base font-semibold text-(--adm-text-primary)">
            Kirim Undangan WA, PDF A5 4 Halaman &amp; Pengingat H-1
          </h3>
          <p class="text-sm leading-relaxed text-(--adm-text-secondary)">
            Tautkan nomor WhatsApp lewat QR/Pairing Code, impor tamu CSV, kirim undangan personal
            beserta PDF 4 halaman &amp; kartu QR, serta terima notifikasi RSVP secara real-time.
          </p>
        </div>
        <div class="flex flex-wrap items-center justify-between gap-2 border-t border-(--adm-border) pt-3">
          <div class="flex flex-wrap gap-1.5">
            <code class="adm-kbd-code">PDF A5 4 Hal</code>
            <code class="adm-kbd-code">Pengingat H-1</code>
          </div>
          <a href="/dokumentasi#whatsapp-gateway" class="adm-link text-xs font-medium">
            Pelajari detail &rarr;
          </a>
        </div>
      </article>

      {/* Bento 6 (half): QR Check-In & Ekspor */}
      <article class="flex flex-col justify-between gap-4 rounded-xl border border-(--adm-border) bg-(--adm-bg-secondary) p-6 md:col-span-3">
        <div class="space-y-2">
          <div class="inline-flex items-center gap-2 text-xs font-semibold text-(--adm-accent)">
            <QrCode className="h-4 w-4" aria-hidden="true" />
            Buku Tamu Digital Hari H
          </div>
          <h3 class="text-base font-semibold text-(--adm-text-primary)">
            Scanner Kamera QR Check-In &amp; Ekspor Data Lengkap
          </h3>
          <p class="text-sm leading-relaxed text-(--adm-text-secondary)">
            Setiap tamu memiliki kode QR unik. Panitia cukup membuka{" "}
            <code class="adm-kbd-code">/checkin</code> di ponsel untuk memindai kehadiran tamu dan
            mengekspor rekap daftar tamu, RSVP, maupun ucapan kapan saja.
          </p>
        </div>
        <div class="flex flex-wrap gap-2 border-t border-(--adm-border) pt-3 text-xs text-(--adm-text-secondary)">
          <span class="adm-badge">Scanner Kamera /checkin</span>
          <span class="adm-badge">Ekspor CSV Tamu &amp; RSVP</span>
          <span class="adm-badge">OTP SHA-256</span>
        </div>
      </article>
    </div>
  </section>

  {/* Harga & Kalkulator Kuota Tamu */}
  <section
    id="harga"
    class="scroll-mt-16 border-y border-(--adm-border) bg-(--adm-bg-secondary)"
    aria-labelledby="judul-harga"
  >
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <p class="text-xs font-semibold tracking-wider text-(--adm-accent) uppercase">
          Skema biaya transparan
        </p>
        <h2
          id="judul-harga"
          class="mt-1.5 text-(length:--adm-text-2xl) font-bold tracking-tight text-(--adm-text-primary)"
        >
          Gratis hingga {FREE_GUEST_QUOTA} tamu, bayar hanya saat butuh lebih
        </h2>
        <p class="mt-2.5 text-sm leading-relaxed text-(--adm-text-secondary) sm:text-base">
          Seluruh fitur utama aktif sejak awal. Penambahan di atas {FREE_GUEST_QUOTA} kontak tamu
          dikenakan biaya Rp{PRICE_PER_GUEST}/tamu (minimal Rp
          {(MIN_PAYMENT_AMOUNT / 1000).toLocaleString("id-ID")}rb untuk +250 kuota).
        </p>
      </div>

      <div class="mx-auto grid max-w-5xl gap-5 md:grid-cols-2">
        {/* Paket Gratis */}
        <div class="flex flex-col justify-between rounded-xl border border-(--adm-border) bg-(--adm-bg-primary) p-6">
          <div>
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-base font-semibold text-(--adm-text-primary)">Paket Gratis</h3>
              <span class="adm-badge adm-badge-success">0 – {FREE_GUEST_QUOTA} Tamu</span>
            </div>
            <div class="mt-4 flex items-baseline gap-1.5">
              <span class="text-3xl font-bold tracking-tight text-(--adm-text-primary) tabular-nums">
                Rp0
              </span>
              <span class="text-xs text-(--adm-text-secondary)">selamanya</span>
            </div>
            <p class="mt-1.5 text-xs text-(--adm-text-secondary)">
              Tanpa biaya pendaftaran &amp; tanpa kartu kredit.
            </p>

            <ul class="mt-5 space-y-2.5 border-t border-(--adm-border) pt-5 text-[13px] text-(--adm-text-secondary)">
              <li class="flex items-start gap-2">
                <Check className="mt-0.5 h-4 w-4 shrink-0 text-(--adm-green)" aria-hidden="true" />
                <span>Hingga {FREE_GUEST_QUOTA} kontak/tamu impor &amp; QR Check-In</span>
              </li>
              <li class="flex items-start gap-2">
                <Check className="mt-0.5 h-4 w-4 shrink-0 text-(--adm-green)" aria-hidden="true" />
                <span>URL undangan unik (/u/nama-pasangan) + 6 tema warna</span>
              </li>
              <li class="flex items-start gap-2">
                <Check className="mt-0.5 h-4 w-4 shrink-0 text-(--adm-green)" aria-hidden="true" />
