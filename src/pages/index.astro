---
import {
  ArrowRight,
  CalendarHeart,
  CheckCircle2,
  Heart,
  MessageSquare,
  QrCode,
  ShieldCheck,
  Sparkles,
  Users,
} from "lucide-react";
import Layout from "../layouts/Layout.astro";
import { getAuthSession } from "../lib/auth";
import { getPlatformConfig } from "../lib/db";
import { ensureReminderSchedulerStarted } from "../lib/reminderScheduler";

ensureReminderSchedulerStarted();
const session = getAuthSession(Astro.cookies);
const platformCfg = getPlatformConfig();
const platformName = platformCfg.PLATFORM_NAME || "Wedding SaaS";

const features = [
  {
    icon: "heart",
    title: "Undangan Digital Eksklusif & Terisolasi",
    desc: "Setiap pasangan memiliki alamat undangan unik (/u/nama-pasangan) dengan 6 pilihan tema, animasi, musik, galeri, RSVP, dan buku tamu yang terpisah penuh.",
  },
  {
    icon: "users",
    title: "Akun Berdua (Calon Suami & Istri)",
    desc: "Pendaftar utama dapat mendaftarkan 1 akun pasangannya dengan username & password masing-masing untuk mengelola persiapan pernikahan bersama.",
  },
  {
    icon: "calendar",
    title: "Manajemen Pernikahan & Fikih Munakahat",
    desc: "Lengkap dengan To-Do List, Anggaran & Vendor, Tabungan Menuju Halal, Mahar/Seserahan/KUA, Jurnal Menikah, dan Tuntunan Fikih Pernikahan.",
  },
  {
    icon: "wa",
    title: "Integrasi WhatsApp Gateway & OTP",
    desc: "Verifikasi pendaftaran & reset password via OTP WhatsApp, kirim undangan PDF + QR otomatis, notifikasi RSVP real-time, serta pengingat H-1.",
  },
  {
    icon: "qr",
    title: "QR Check-In Hari H & Desain PDF",
    desc: "Scanner kamera QR Code untuk buku tamu Hari H, cetak kartu QR tamu, dan generator surat undangan PDF 4 halaman siap kirim.",
  },
  {
    icon: "shield",
    title: "Privasi Data Terjaga Antar Pasangan",
    desc: "Seluruh data tamu, RSVP, ucapan, anggaran, tabungan, dan sesi WhatsApp diisolasi ketat per pasangan tanpa pernah bercampur.",
  },
];
---

<Layout
  title={`${platformName} — Platform Undangan & Manajemen Pernikahan Digital`}
  description="Buat undangan pernikahan digital, kelola persiapan pernikahan bersama pasangan, kirim undangan via WhatsApp, dan check-in QR tamu Hari H dalam satu platform."
>
  <div class="min-h-dvh bg-slate-950 text-slate-100">
    {/* Navbar */}
    <header class="sticky top-0 z-40 border-b border-white/10 bg-slate-950/85 backdrop-blur-md">
      <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
        <a href="/" class="flex items-center gap-2.5 text-white">
          <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-sky-500/15 text-sky-400 ring-1 ring-sky-400/30">
            <Heart className="h-4 w-4" />
          </span>
          <span class="font-serif text-lg font-semibold tracking-tight">
            {platformName}
          </span>
        </a>

        <nav class="flex items-center gap-2 sm:gap-3">
          <a
            href="/demo"
            class="rounded-lg px-3 py-1.5 text-xs font-medium text-slate-300 transition hover:bg-white/5 hover:text-white sm:text-sm"
          >
            Lihat Demo
          </a>
          {session ? (
            <a
              href={session.role === "superadmin" ? "/superadmin" : "/admin"}
              class="inline-flex items-center gap-1.5 rounded-lg bg-sky-500 px-3.5 py-2 text-xs font-semibold text-white shadow-sm transition hover:bg-sky-400 sm:text-sm"
            >
              Buka Dashboard
              <ArrowRight className="h-3.5 w-3.5" />
            </a>
          ) : (
            <>
              <a
                href="/masuk"
                class="rounded-lg border border-white/15 px-3.5 py-1.5 text-xs font-medium text-white transition hover:bg-white/10 sm:text-sm"
              >
                Masuk
              </a>
              <a
                href="/daftar"
                class="inline-flex items-center gap-1.5 rounded-lg bg-sky-500 px-3.5 py-2 text-xs font-semibold text-white shadow-sm transition hover:bg-sky-400 sm:text-sm"
              >
                Daftar Gratis
                <ArrowRight className="h-3.5 w-3.5" />
              </a>
            </>
          )}
        </nav>
      </div>
    </header>

    {/* Hero */}
    <section class="relative overflow-hidden px-4 pt-16 pb-20 sm:px-6 sm:pt-24 sm:pb-28">
      <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(56,189,248,0.16),transparent_60%)]"></div>
      <div class="relative mx-auto max-w-4xl text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-sky-400/25 bg-sky-500/10 px-3.5 py-1 text-xs font-medium text-sky-300">
          <Sparkles className="h-3.5 w-3.5" />
          Platform Undangan Digital &amp; Manajemen Persiapan Nikah
        </div>
        <h1 class="mt-6 font-serif text-4xl leading-tight font-semibold tracking-tight text-white sm:text-5xl md:text-6xl">
          Satu Ruang Indah untuk Merencanakan &amp; Mengundang di Hari Bahagia
        </h1>
        <p class="mx-auto mt-5 max-w-2xl text-sm leading-relaxed text-slate-300 sm:text-base">
          Daftar mandiri dalam hitungan menit, undang pasangan Anda dengan akun
          masing-masing, susun anggaran &amp; tabungan nikah, lalu bagikan
          undangan digital personal lengkap dengan WhatsApp Gateway &amp; QR
          Check-In.
        </p>

        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          <a
            href="/daftar"
            class="inline-flex items-center gap-2 rounded-xl bg-sky-500 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-sky-500/20 transition hover:bg-sky-400"
          >
            Buat Undangan Sekarang
            <ArrowRight className="h-4 w-4" />
          </a>
          <a
            href="/demo"
            class="inline-flex items-center gap-2 rounded-xl border border-white/15 bg-white/5 px-6 py-3 text-sm font-semibold text-white transition hover:bg-white/10"
          >
            <Sparkles className="h-4 w-4 text-sky-400" />
            Lihat Demo Undangan Publik
          </a>
        </div>

        <div class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs text-slate-400">
          <span class="inline-flex items-center gap-1.5">
            <CheckCircle2 className="h-3.5 w-3.5 text-emerald-400" />
            Verifikasi OTP WhatsApp
          </span>
          <span class="inline-flex items-center gap-1.5">
            <CheckCircle2 className="h-3.5 w-3.5 text-emerald-400" />
            2 Akun (Suami &amp; Istri)
          </span>
          <span class="inline-flex items-center gap-1.5">
            <CheckCircle2 className="h-3.5 w-3.5 text-emerald-400" />
            URL Unik /u/nama-pasangan
          </span>
        </div>
      </div>
    </section>

    {/* Features */}
    <section class="border-t border-white/10 bg-slate-900/50 px-4 py-16 sm:px-6 sm:py-20">
      <div class="mx-auto max-w-6xl">
        <div class="mx-auto max-w-2xl text-center">
          <h2 class="font-serif text-2xl font-semibold text-white sm:text-3xl">
            Semua yang Dibutuhkan Calon Pengantin
          </h2>
          <p class="mt-2 text-sm text-slate-400">
            Dirancang untuk memudahkan kolaborasi pasangan dari masa persiapan
            hingga hari resepsi.
          </p>
        </div>

        <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {features.map((f) => (
            <div class="rounded-2xl border border-white/10 bg-slate-900/80 p-6 transition hover:border-sky-400/30">
              <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-sky-500/10 text-sky-400">
                {f.icon === "heart" && <Heart className="h-5 w-5" />}
                {f.icon === "users" && <Users className="h-5 w-5" />}
                {f.icon === "calendar" && <CalendarHeart className="h-5 w-5" />}
                {f.icon === "wa" && <MessageSquare className="h-5 w-5" />}
                {f.icon === "qr" && <QrCode className="h-5 w-5" />}
                {f.icon === "shield" && <ShieldCheck className="h-5 w-5" />}
              </div>
              <h3 class="mt-4 text-base font-semibold text-white">{f.title}</h3>
              <p class="mt-2 text-xs leading-relaxed text-slate-400 sm:text-sm">
                {f.desc}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* Footer */}
    <footer class="border-t border-white/10 px-4 py-8 text-center text-xs text-slate-400 sm:px-6">
      <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-3 sm:flex-row">
        <span>
          &copy; 2018 - {new Date().getFullYear()}{" "}
          <strong class="font-semibold text-slate-200 uppercase">
            ZEDLABS Teknologi Indonesia
          </strong>
        </span>
        <div class="flex items-center gap-4">
          <a href="/demo" class="hover:text-white">Demo</a>
          <a href="/daftar" class="hover:text-white">Daftar</a>
          <a href="/masuk" class="hover:text-white">Masuk</a>
          <a href="/lupa-password" class="hover:text-white">Lupa Password</a>
        </div>
      </div>
    </footer>
  </div>
</Layout>
