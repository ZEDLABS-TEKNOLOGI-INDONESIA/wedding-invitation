---
import QRCodeGenerator from "../components/QRCodeGenerator";
import Layout from "../layouts/Layout.astro";
import { getAuthSession } from "../lib/auth";

Astro.response.headers.set("Cache-Control", "no-store");

const session = getAuthSession(Astro.cookies);
if (!session) {
  return Astro.redirect("/masuk");
}

const origin = (
  Astro.site?.toString() ||
  Astro.url.origin ||
  "https://wedding.zedlabs.id"
).replace(/\/+$/, "");
const tenantSiteUrl = `${origin}${session.isDemo ? "/demo" : `/u/${session.weddingSlug}`}`;
---

<Layout title="QR Code Generator" noindex={true}>
  <div class="min-h-screen bg-slate-50 px-4 py-20 dark:bg-slate-900">
    <div class="mx-auto max-w-[1280px] space-y-8">
      <div class="space-y-2 text-center">
        <h1 class="font-serif text-4xl italic dark:text-white">
          QR Code Generator
        </h1>
        <p class="text-slate-500">
          Buat QR Code unik untuk setiap tamu undangan
        </p>
      </div>

      <div
        class="rounded-3xl border border-slate-100 bg-white p-8 shadow-xl dark:border-white/5 dark:bg-slate-800"
      >
        <QRCodeGenerator
          client:load
          siteUrl={tenantSiteUrl}
        />
      </div>

      <div class="text-center">
        <a
          href="/admin"
          class="text-sm font-bold tracking-widest text-slate-400 uppercase hover:text-slate-600"
        >
          &larr; Kembali ke Dashboard
        </a>
      </div>
    </div>
  </div>
</Layout>
