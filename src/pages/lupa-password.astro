---
import { ArrowLeft, KeyRound, ShieldCheck } from "lucide-react";
import Layout from "../layouts/Layout.astro";

Astro.response.headers.set("Cache-Control", "no-store");
---

<Layout title="Reset Password — Wedding SaaS" noindex={true}>
  <div class="flex min-h-dvh flex-col items-center justify-center bg-slate-950 px-4 py-10 text-slate-100">
    <div class="w-full max-w-md space-y-6">
      <div class="text-center">
        <a
          href="/"
          class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-sky-500/15 text-sky-400 ring-1 ring-sky-400/30"
        >
          <KeyRound className="h-5 w-5" />
        </a>
        <h1 class="mt-4 font-serif text-2xl font-semibold text-white">
          Reset Password via WhatsApp
        </h1>
        <p class="mt-1 text-xs text-slate-400">
          Masukkan username atau nomor WhatsApp akun Anda untuk menerima kode OTP reset password.
        </p>
      </div>

      {/* Step 1 */}
      <form
        id="reset-step1"
        class="space-y-4 rounded-2xl border border-white/10 bg-slate-900/90 p-6 shadow-xl"
      >
        <div class="space-y-1.5">
          <label for="identifier" class="block text-xs font-medium text-slate-300">
            Username atau Nomor WhatsApp *
          </label>
          <input
            id="identifier"
            name="identifier"
            type="text"
            required
            placeholder="contoh: danik atau 081234567890"
            class="w-full rounded-xl border border-white/10 bg-slate-950 px-3.5 py-2.5 text-sm text-white placeholder-slate-500 focus:border-sky-400 focus:outline-none"
          />
        </div>

        <div
          id="reset1-error"
          class="hidden rounded-xl border border-red-500/30 bg-red-500/10 px-3.5 py-2.5 text-xs text-red-200"
        >
        </div>

        <button
          id="btn-reset-otp"
          type="submit"
          class="w-full rounded-xl bg-sky-500 py-2.5 text-sm font-semibold text-white transition hover:bg-sky-400 disabled:opacity-50"
        >
          Kirim Kode OTP Reset
        </button>
      </form>

      {/* Step 2 */}
      <form
        id="reset-step2"
        class="hidden space-y-4 rounded-2xl border border-white/10 bg-slate-900/90 p-6 shadow-xl"
      >
        <div class="flex items-start gap-3 rounded-xl border border-sky-400/25 bg-sky-500/10 p-3.5 text-xs text-sky-100">
          <ShieldCheck className="mt-0.5 h-4 w-4 shrink-0 text-sky-400" />
          <div id="reset-info">Kode OTP telah dikirim ke WhatsApp Anda.</div>
        </div>

        <div class="space-y-1.5">
          <label for="reset-code" class="block text-xs font-medium text-slate-300">
            Kode OTP 6 Digit *
          </label>
          <input
            id="reset-code"
            type="text"
            inputmode="numeric"
            maxlength="6"
            required
            placeholder="123456"
            class="w-full rounded-xl border border-white/10 bg-slate-950 px-3 py-2.5 text-center font-mono text-xl tracking-[0.35em] text-white placeholder-slate-600 focus:border-sky-400 focus:outline-none"
          />
        </div>

        <div class="space-y-1.5">
          <label for="new-password" class="block text-xs font-medium text-slate-300">
            Password Baru (min. 6 karakter) *
          </label>
          <input
            id="new-password"
            type="password"
            required
            minlength="6"
            placeholder="Masukkan password baru"
            class="w-full rounded-xl border border-white/10 bg-slate-950 px-3.5 py-2.5 text-sm text-white placeholder-slate-500 focus:border-sky-400 focus:outline-none"
          />
        </div>

        <div
          id="reset2-error"
          class="hidden rounded-xl border border-red-500/30 bg-red-500/10 px-3.5 py-2.5 text-xs text-red-200"
        >
        </div>
        <div
          id="reset2-success"
          class="hidden rounded-xl border border-emerald-500/30 bg-emerald-500/10 px-3.5 py-2.5 text-xs text-emerald-200"
        >
        </div>

        <button
          id="btn-reset-save"
          type="submit"
          class="w-full rounded-xl bg-emerald-500 py-2.5 text-sm font-semibold text-white transition hover:bg-emerald-400 disabled:opacity-50"
        >
          Simpan Password Baru
        </button>
      </form>

      <div class="text-center">
        <a
          href="/masuk"
          class="inline-flex items-center gap-1.5 text-xs text-slate-400 hover:text-white"
        >
          <ArrowLeft className="h-3.5 w-3.5" />
          Kembali ke Halaman Masuk
        </a>
      </div>
    </div>
  </div>
</Layout>

<script>
  const step1 = document.getElementById("reset-step1") as HTMLFormElement | null;
  const step2 = document.getElementById("reset-step2") as HTMLFormElement | null;
  const err1 = document.getElementById("reset1-error");
  const err2 = document.getElementById("reset2-error");
  const ok2 = document.getElementById("reset2-success");
  const info = document.getElementById("reset-info");
  const btnOtp = document.getElementById("btn-reset-otp") as HTMLButtonElement | null;
  const btnSave = document.getElementById("btn-reset-save") as HTMLButtonElement | null;

  let targetPhone = "";

  step1?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!err1 || !btnOtp) return;
    err1.classList.add("hidden");
    btnOtp.disabled = true;
    btnOtp.textContent = "Mengirim OTP...";

    const identifier = (document.getElementById("identifier") as HTMLInputElement | null)?.value || "";
    try {
      const res = await fetch("/api/auth/reset-otp", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ identifier }),
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.success) {
        targetPhone = data.phone;
        if (info) {
          info.textContent = data.devOtp
            ? `Mode pengembangan (WA Platform belum diatur): kode OTP untuk ${data.username} (${data.maskedPhone}) adalah ${data.devOtp}.`
            : `Kode OTP telah dikirim ke WhatsApp ${data.maskedPhone} untuk akun "${data.username}".`;
        }
        step1.classList.add("hidden");
        step2?.classList.remove("hidden");
        return;
      }
      err1.textContent = data.error || "Gagal mengirim OTP reset password.";
      err1.classList.remove("hidden");
    } catch {
      err1.textContent = "Gagal terhubung ke server.";
      err1.classList.remove("hidden");
    } finally {
      btnOtp.disabled = false;
      btnOtp.textContent = "Kirim Kode OTP Reset";
    }
  });

  step2?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!err2 || !ok2 || !btnSave) return;
    err2.classList.add("hidden");
    ok2.classList.add("hidden");
    btnSave.disabled = true;
    btnSave.textContent = "Menyimpan...";

    const code = (document.getElementById("reset-code") as HTMLInputElement | null)?.value || "";
    const newPassword = (document.getElementById("new-password") as HTMLInputElement | null)?.value || "";
    try {
      const res = await fetch("/api/auth/reset-verify", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ phone: targetPhone, code, newPassword }),
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.success) {
        ok2.textContent = data.message || "Password berhasil diubah! Mengalihkan ke halaman masuk...";
        ok2.classList.remove("hidden");
        setTimeout(() => {
          window.location.href = "/masuk";
        }, 1500);
        return;
      }
      err2.textContent = data.error || "Gagal mereset password.";
      err2.classList.remove("hidden");
    } catch {
      err2.textContent = "Gagal terhubung ke server.";
      err2.classList.remove("hidden");
    } finally {
      btnSave.disabled = false;
      btnSave.textContent = "Simpan Password Baru";
    }
  });
</script>
