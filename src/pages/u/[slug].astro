---
import App from "../../App";
import Layout from "../../layouts/Layout.astro";
import { getPublicConfig, getWeddingBySlug } from "../../lib/db";
import { ensureReminderSchedulerStarted } from "../../lib/reminderScheduler";
import {
  normalizePublicDefaultMode,
  normalizePublicTheme,
} from "../../utils/publicThemes";

ensureReminderSchedulerStarted();

const slug = (Astro.params.slug || "").trim().toLowerCase();
const wedding = getWeddingBySlug(slug);

if (!wedding || wedding.status !== "active") {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

const safeConfig = getPublicConfig(wedding.id);

const brideName = safeConfig.BRIDE_NICKNAME || "Mempelai Wanita";
const groomName = safeConfig.GROOM_NICKNAME || "Mempelai Pria";
const eventDate = safeConfig.AKAD_DATE || "";
const venueName = safeConfig.VENUE_NAME || "";
const weddingTheme = normalizePublicTheme(safeConfig.PUBLIC_THEME);
const defaultColorMode = normalizePublicDefaultMode(
  safeConfig.PUBLIC_DEFAULT_MODE
);
const allowGuestThemeSwitch = safeConfig.PUBLIC_ALLOW_THEME_SWITCH !== "false";

const pageTitle = `Pernikahan ${brideName} & ${groomName}`;
const pageDescription = eventDate
  ? `Undangan Pernikahan ${brideName} & ${groomName} — ${eventDate}${venueName ? ` di ${venueName}` : ""}.`
  : `Undangan Pernikahan Digital ${brideName} & ${groomName}.`;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  weddingTheme={weddingTheme}
  defaultColorMode={defaultColorMode}
  allowGuestThemeSwitch={allowGuestThemeSwitch}
>
  <App client:load initialRawConfig={safeConfig} weddingSlug={wedding.slug} />
</Layout>
