---
import "@fontsource/cormorant-garamond/300.css";
import "@fontsource/cormorant-garamond/400.css";
import "@fontsource/cormorant-garamond/400-italic.css";
import "@fontsource/cormorant-garamond/500.css";
import "@fontsource/cormorant-garamond/600.css";
import "@fontsource/cormorant-garamond/600-italic.css";
import "@fontsource/cormorant-garamond/700.css";
import "@fontsource/great-vibes/400.css";
import "@fontsource/lexend/400.css";
import "@fontsource/lexend/500.css";
import "@fontsource/lexend/600.css";
import "@fontsource/lexend/700.css";
import "@fontsource/outfit/300.css";
import "@fontsource/outfit/400.css";
import "@fontsource/outfit/500.css";
import "@fontsource/outfit/600.css";
import lexend400 from "@fontsource/lexend/files/lexend-latin-400-normal.woff2?url";
import lexend500 from "@fontsource/lexend/files/lexend-latin-500-normal.woff2?url";
import lexend600 from "@fontsource/lexend/files/lexend-latin-600-normal.woff2?url";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  weddingTheme?: string;
  defaultColorMode?: "system" | "light" | "dark";
  allowGuestThemeSwitch?: boolean;
}

const {
  title = "Wedding Management",
  description = "Platform Undangan Pernikahan Digital, RSVP, Check-In QR & Manajemen Persiapan Nikah.",
  image = "/thumbnail.png",
  imageAlt = title,
  noindex = false,
  weddingTheme = "ocean",
  defaultColorMode = "system",
  allowGuestThemeSwitch = true,
} = Astro.props;

const siteBase = Astro.site || "https://wedding.zedlabs.id";
const normalizedPath =
  Astro.url.pathname === "/" ? "/" : Astro.url.pathname.replace(/\/+$/, "");
const canonicalURL = new URL(normalizedPath, siteBase);
const ogImageURL = image.startsWith("http")
  ? image
  : new URL(image, siteBase).toString();
---

<!doctype html>
<html
  lang="id"
  class="scroll-smooth"
  data-wedding-theme={weddingTheme}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" sizes="any" href="/favicon.ico" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:site_name" content="Wedding Management — ZEDLABS" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- PWA & Browser Chrome -->
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f6f8fa" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0d1117" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta
      name="apple-mobile-web-app-status-bar-style"
      content="black-translucent"
    />
    <meta name="apple-mobile-web-app-title" content="Wedding" />

    <!-- Preload bobot utama font UI agar mencegah FOUT & CLS -->
    <link rel="preload" href={lexend400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={lexend500} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={lexend600} as="font" type="font/woff2" crossorigin />

    <script is:inline define:vars={{ defaultColorMode, weddingTheme, allowGuestThemeSwitch }}>
      (function () {
        var root = document.documentElement;
        var stored = null;
        var storedPalette = null;
        try {
          stored = localStorage.getItem("theme");
          if (allowGuestThemeSwitch) {
            storedPalette = localStorage.getItem("wedding_public_theme");
          }
        } catch {}
        var preferDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        var theme =
          stored ||
          (defaultColorMode === "dark" || defaultColorMode === "light"
            ? defaultColorMode
            : preferDark
              ? "dark"
              : "light");
        root.setAttribute("data-theme", theme);
        if (theme === "dark") {
          root.classList.add("dark");
        } else {
          root.classList.remove("dark");
        }
        var validPalettes = ["ocean", "sage", "blush", "maroon", "gold", "lavender"];
        var palette =
          storedPalette && validPalettes.indexOf(storedPalette) !== -1
            ? storedPalette
            : weddingTheme;
        root.setAttribute("data-wedding-theme", palette);
      })();
    </script>
  </head>
  <body>
    <slot />

    <script is:inline>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", function () {
          navigator.serviceWorker
            .register("/sw.js", { scope: "/" })
            .catch(function () {});
        });
      }
    </script>
  </body>
</html>
