---
import { Moon, Sun } from "lucide-react";
import PublicFooter from "../components/public/PublicFooter.astro";
import PublicMobileNav, {
  type PublicNavItem,
} from "../components/public/PublicMobileNav";
import PwaInstallToast from "../components/public/PwaInstallToast";
import { getAuthSession } from "../lib/auth";
import { getPlatformConfig } from "../lib/db";
import Layout from "./Layout.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description = "Platform undangan pernikahan digital & manajemen persiapan nikah terisolasi per pasangan dari ZEDLABS Teknologi Indonesia.",
  image = "/og-default.png",
  noindex = false,
} = Astro.props;

const session = getAuthSession(Astro.cookies);
const platformCfg = getPlatformConfig();
const platformName = platformCfg.PLATFORM_NAME || "Wedding Management";
const dashboardHref = session?.role === "superadmin" ? "/superadmin" : "/admin";

const nav: PublicNavItem[] = [
  { href: "/#fitur", label: "Fitur" },
  { href: "/#harga", label: "Harga" },
  { href: "/demo", label: "Demo" },
  { href: "/layanan-mandiri", label: "Panduan", aktifDi: ["/layanan-mandiri"] },
  { href: "/dokumentasi", label: "Dokumentasi" },
  { href: "/faq", label: "FAQ" },
  { href: "/bantuan", label: "Bantuan" },
];

const currentPath = Astro.url.pathname;
const cekAktif = (item: PublicNavItem) =>
  item.aktifDi ? item.aktifDi.includes(currentPath) : currentPath === item.href;
---

<Layout title={title} description={description} image={image} noindex={noindex}>
  <div class="admin-shell flex min-h-dvh flex-col bg-(--adm-bg-primary) text-(--adm-text-primary)">
    <a href="#konten-utama" class="skip-link">
      Lewati ke konten utama
    </a>

    {/* Header 1:1 struktur & gaya whatsapp-service */}
    <header class="sticky top-0 z-40 border-b border-(--adm-border) bg-(--adm-bg-secondary)">
      <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6">
        <div class="flex shrink-0 items-center gap-2.5">
          <a
            href="/"
            aria-label={`Beranda ${platformName}`}
            class="flex min-h-[44px] items-center gap-2.5 no-underline"
          >
            <img
              src="/favicon.svg"
              alt=""
              width="28"
              height="28"
              class="h-7 w-7 rounded-md"
            />
            <span class="hidden text-sm font-semibold tracking-tight text-(--adm-text-primary) sm:inline">
              {platformName}
            </span>
          </a>
          <a
            href="/dokumentasi"
            class="hidden items-center rounded-full border border-(--adm-info-border) bg-(--adm-accent-soft) px-2 py-0.5 font-mono text-[11px] font-medium text-(--adm-accent) transition-opacity hover:opacity-90 md:inline-flex"
          >
            Multi-Pasangan
          </a>
        </div>

        <nav aria-label="Navigasi utama" class="hidden items-center gap-1 text-sm lg:flex">
          {nav.map((item) => {
            const aktif = cekAktif(item);
            return (
              <a
                href={item.href}
                aria-current={aktif ? "page" : undefined}
                class:list={[
                  "rounded-md px-3 py-1.5 whitespace-nowrap transition-colors duration-150",
                  aktif
                    ? "font-semibold text-(--adm-accent)"
                    : "text-(--adm-text-secondary) hover:bg-(--adm-bg-overlay) hover:text-(--adm-text-primary)",
                ]}
              >
                {item.label}
              </a>
            );
          })}
        </nav>

        <div class="flex shrink-0 items-center gap-2">
          <button
            id="pub-theme-toggle"
            type="button"
            aria-label="Ganti tema terang/gelap"
            title="Ganti Tema"
            class="inline-flex h-8.5 w-8.5 cursor-pointer items-center justify-center rounded-md border border-(--adm-border) bg-(--adm-bg-tertiary) text-(--adm-text-secondary) transition-colors hover:bg-(--adm-bg-overlay) hover:text-(--adm-text-primary)"
          >
            <Moon className="h-4 w-4 dark:hidden" />
            <Sun className="hidden h-4 w-4 dark:inline" />
          </button>

          {session ? (
            <a
              href={dashboardHref}
              class="adm-btn adm-btn-primary hidden sm:inline-flex"
            >
              Dashboard
            </a>
          ) : (
            <>
              <a
                href="/masuk"
                class="adm-btn adm-btn-ghost hidden sm:inline-flex"
              >
                Masuk
              </a>
              <a
                href="/daftar"
                class="adm-btn adm-btn-primary hidden sm:inline-flex"
              >
                Daftar
              </a>
            </>
          )}

          <PublicMobileNav
            nav={nav}
            currentPath={currentPath}
            isLoggedIn={Boolean(session)}
            dashboardHref={dashboardHref}
            client:load
          />
        </div>
      </div>
    </header>

    <main id="konten-utama" tabindex="-1" class="w-full flex-1 focus:outline-none">
      <slot />
    </main>

    <PublicFooter varian="publik" platformName={platformName} />
    <PwaInstallToast client:idle />
  </div>
</Layout>

<script>
  const themeBtn = document.getElementById("pub-theme-toggle");
  themeBtn?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");
    document.documentElement.setAttribute("data-theme", isDark ? "dark" : "light");
    try {
      localStorage.setItem("theme", isDark ? "dark" : "light");
    } catch {
      // ignore
    }
  });
</script>
