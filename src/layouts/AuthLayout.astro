---
import { ArrowLeft, Moon, Sun } from "lucide-react";
import { getPlatformConfig } from "../lib/db";
import Layout from "./Layout.astro";

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}

const { title, description, wide = false } = Astro.props;
const platformCfg = getPlatformConfig();
const platformName = platformCfg.PLATFORM_NAME || "Wedding Management";
const tahunSekarang = new Date().getFullYear();
---

<Layout title={`${title} | ${platformName}`} noindex={true}>
  <div class="admin-shell flex min-h-dvh flex-col bg-(--adm-bg-primary) text-(--adm-text-primary)">
    <header class="border-b border-(--adm-border) bg-(--adm-bg-secondary)">
      <div class="mx-auto flex h-13 max-w-5xl items-center justify-between px-4 sm:px-6">
        <a
          href="/"
          class="inline-flex items-center gap-1.5 text-xs font-medium text-(--adm-text-secondary) hover:text-(--adm-accent)"
        >
          <ArrowLeft className="h-3.5 w-3.5" />
          Kembali ke Beranda
        </a>
        <button
          id="auth-theme-toggle"
          type="button"
          aria-label="Ganti tema terang/gelap"
          title="Ganti Tema"
          class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-(--adm-border) bg-(--adm-bg-tertiary) text-(--adm-text-secondary) hover:text-(--adm-text-primary)"
        >
          <Moon className="h-4 w-4 dark:hidden" />
          <Sun className="hidden h-4 w-4 dark:inline" />
        </button>
      </div>
    </header>

    <main class="flex flex-1 items-center justify-center px-4 py-10">
      <div class={`w-full ${wide ? "max-w-2xl" : "max-w-md"} space-y-5`}>
        <div class="text-center">
          <a
            href="/"
            class="inline-flex h-12 w-12 items-center justify-center rounded-xl border border-(--adm-border) bg-(--adm-bg-secondary) p-1.5"
          >
            <img
              src="/logo.png"
              alt={platformName}
              class="h-full w-full object-contain"
            />
          </a>
          <h1 class="mt-3 text-xl font-semibold text-(--adm-text-primary)">
            {title}
          </h1>
          {description && (
            <p class="mt-1.5 text-xs leading-relaxed text-(--adm-text-secondary)">
              {description}
            </p>
          )}
        </div>

        <div class="adm-card p-6">
          <slot />
        </div>
      </div>
    </main>

    <footer class="flex min-h-[44px] shrink-0 flex-col flex-wrap items-center justify-center gap-x-6 gap-y-1.5 border-t border-(--adm-border) bg-(--adm-bg-secondary) px-4 py-2.5 text-center text-[11px] text-(--adm-text-secondary) md:flex-row md:px-6">
      <span class="whitespace-nowrap">
        &copy; 2018 - {tahunSekarang}{" "}
        <a
          href="https://zedlabs.id"
          target="_blank"
          rel="noreferrer"
          class="font-bold tracking-wide text-(--adm-text-secondary) uppercase hover:text-(--adm-accent)"
        >
          ZEDLABS TEKNOLOGI INDONESIA
        </a>
      </span>
      <nav class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1">
        <a href="/dokumentasi" class="hover:text-(--adm-accent)">Dokumentasi</a>
        <span class="opacity-40">|</span>
        <a href="/bantuan" class="hover:text-(--adm-accent)">Hubungi Kami</a>
        <span class="opacity-40">|</span>
        <a href="/faq" class="hover:text-(--adm-accent)">FAQ</a>
        <span class="opacity-40">|</span>
        <a href="/syarat-ketentuan" class="hover:text-(--adm-accent)">
          Syarat dan Ketentuan
        </a>
        <span class="opacity-40">|</span>
        <a href="/kebijakan-privasi" class="hover:text-(--adm-accent)">
          Kebijakan Privasi
        </a>
        <span class="opacity-40">|</span>
        <a href="/layanan-mandiri" class="hover:text-(--adm-accent)">
          Layanan Mandiri
        </a>
      </nav>
    </footer>
  </div>
</Layout>

<script>
  const btn = document.getElementById("auth-theme-toggle");
  btn?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");
    document.documentElement.setAttribute("data-theme", isDark ? "dark" : "light");
    try {
      localStorage.setItem("theme", isDark ? "dark" : "light");
    } catch {
      // ignore
    }
  });
</script>
