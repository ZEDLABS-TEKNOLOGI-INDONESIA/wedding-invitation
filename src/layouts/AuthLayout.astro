---
import { Check, Moon, Sun } from "lucide-react";
import PublicFooter from "../components/public/PublicFooter.astro";
import { getPlatformConfig } from "../lib/db";
import Layout from "./Layout.astro";

interface Props {
  title: string;
  eyebrow?: string;
  description?: string;
  wide?: boolean;
}

const {
  title,
  eyebrow = "Panel Pasangan",
  description = "Gunakan username dan kata sandi akun Anda untuk mengakses dashboard.",
  wide = false,
} = Astro.props;

const platformCfg = getPlatformConfig();
const platformName = platformCfg.PLATFORM_NAME || "Wedding Management";

const fitur = [
  {
    judul: "Terisolasi penuh per pasangan",
    isi: "Setiap pasangan memiliki alamat unik (/u/nama-pasangan) beserta daftar tamu, RSVP, ucapan, dan sesi WhatsApp sendiri.",
  },
  {
    judul: "Kolaborasi akun berdua (suami & istri)",
    isi: "Pemilik utama dapat menambahkan 1 akun pasangan untuk menyusun anggaran, to-do list, dan berkas KUA bersama.",
  },
  {
    judul: "WhatsApp Gateway, PDF 4 halaman & QR Check-In",
    isi: "Kirim undangan personal otomatis beserta PDF A5 & kartu QR, notifikasi RSVP, hingga scanner kamera Hari H.",
  },
];
---

<Layout title={`${title} | ${platformName}`} noindex={true}>
  <div class="admin-shell is-public min-h-dvh bg-(--adm-bg-primary) text-(--adm-text-primary)">
    <a href="#konten-utama" class="skip-link">
      Lewati ke konten utama
    </a>

    {wide ? (
      <div class="flex min-h-dvh flex-col bg-(--adm-bg-primary) text-(--adm-text-primary)">
        <header class="sticky top-0 z-40 border-b border-(--adm-border) bg-(--adm-bg-secondary)">
          <div class="mx-auto flex h-14 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6">
            <div class="flex shrink-0 items-center gap-2.5">
              <a
                href="/"
                aria-label={`Beranda ${platformName}`}
                class="flex min-h-[44px] items-center gap-2 no-underline"
              >
                <img
                  src="/favicon.svg"
                  alt=""
                  width="26"
                  height="26"
                  class="h-6.5 w-6.5 rounded-md"
                />
                <span class="text-sm font-semibold tracking-tight text-(--adm-text-primary)">
                  {platformName}
                </span>
              </a>
            </div>

            <div class="flex shrink-0 items-center gap-2">
              <a href="/dokumentasi" class="adm-btn adm-btn-ghost adm-btn-sm hidden sm:inline-flex">
                Dokumentasi
              </a>
              <button
                id="auth-theme-toggle"
                type="button"
                aria-label="Ganti tema terang/gelap"
                title="Ganti Tema"
                class="inline-flex h-8 w-8 cursor-pointer items-center justify-center rounded-md border border-(--adm-border) bg-(--adm-bg-tertiary) text-(--adm-text-secondary) hover:bg-(--adm-bg-overlay) hover:text-(--adm-text-primary)"
              >
                <Moon className="h-4 w-4 dark:hidden" />
                <Sun className="hidden h-4 w-4 dark:inline" />
              </button>
              <a href="/masuk" class="adm-btn adm-btn-secondary adm-btn-sm">
                Masuk
              </a>
            </div>
          </div>
        </header>

        <main id="konten-utama" tabindex="-1" class="auth-wide-bg flex-1 focus:outline-none">
          <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-12">
            <div class="mb-6 max-w-2xl sm:mb-8">
              <p class="text-xs font-semibold tracking-wider text-(--adm-accent) uppercase">
                {eyebrow}
              </p>
              <h1 class="mt-1.5 text-(length:--adm-text-2xl) font-bold tracking-tight text-(--adm-text-primary)">
                {title}
              </h1>
              {description && (
                <p class="mt-2 text-sm leading-relaxed text-(--adm-text-secondary) sm:text-base">
                  {description}
                </p>
              )}
            </div>

            <div class="rounded-2xl border border-(--adm-border) bg-(--adm-bg-secondary) p-5 sm:p-8">
              <slot />
            </div>
          </div>
        </main>

        <PublicFooter varian="aplikasi" platformName={platformName} />
      </div>
    ) : (
      <div class="auth-grid min-h-dvh bg-(--adm-bg-primary) text-(--adm-text-primary)">
        <div class="auth-kiri relative flex min-w-0 flex-col">
          <button
            id="auth-theme-toggle"
            type="button"
            aria-label="Ganti tema terang/gelap"
            title="Ganti Tema"
            class="absolute top-4 right-4 z-10 inline-flex h-8 w-8 cursor-pointer items-center justify-center rounded-md border border-(--adm-border) bg-(--adm-bg-tertiary) text-(--adm-text-secondary) hover:bg-(--adm-bg-overlay) hover:text-(--adm-text-primary)"
          >
            <Moon className="h-4 w-4 dark:hidden" />
            <Sun className="hidden h-4 w-4 dark:inline" />
          </button>

          <main id="konten-utama" tabindex="-1" class="flex flex-1 p-4 sm:p-6 focus:outline-none">
            <div class="m-auto w-full max-w-[416px] overflow-hidden rounded-lg border border-(--adm-border) bg-(--adm-bg-secondary)">
              <div class="flex flex-col items-center gap-2 border-b border-(--adm-border) px-5 pt-6 pb-5 text-center">
                <a href="/" class="flex items-center gap-2 text-(--adm-text-primary) no-underline">
                  <img
                    src="/favicon.svg"
                    alt=""
                    width="28"
                    height="28"
                    class="h-7 w-7 rounded-md"
                  />
                  <span class="text-sm font-semibold">{platformName}</span>
                </a>
                <h1 class="text-xl font-semibold text-(--adm-text-primary)">{title}</h1>
                {description && (
                  <p class="text-sm text-(--adm-text-secondary)">{description}</p>
                )}
              </div>
              <div class="p-6 sm:p-7">
                <slot />
              </div>
            </div>
          </main>

          <PublicFooter varian="aplikasi" platformName={platformName} />
        </div>

        <div
          class="auth-kanan relative flex-col justify-center overflow-hidden px-24"
          aria-hidden="true"
        >
          <img
            src="/favicon.svg"
            alt=""
            width="640"
            height="640"
            class="pointer-events-none absolute top-1/2 -right-40 h-[640px] w-[640px] -translate-y-1/2 opacity-5"
          />
          <div class="pointer-events-none absolute inset-x-0 -bottom-12 text-center text-[220px] leading-none font-bold tracking-[-4px] whitespace-nowrap uppercase opacity-5 select-none">
            Wedding
          </div>

          <div class="relative max-w-[560px]">
            <div class="flex items-center gap-2.5 text-xs font-semibold tracking-[1.2px] text-(--adm-accent) uppercase">
              <span class="h-px w-5 bg-(--adm-accent)"></span>
              {platformName}
            </div>
            <h2 class="mt-4 text-4xl leading-tight font-semibold text-(--adm-text-primary)">
              Undangan digital dan persiapan nikah, dikelola berdua dari satu panel.
            </h2>
            <p class="mt-4 text-[15px] text-(--adm-text-secondary)">
              Ruang undangan, 6 modul persiapan nikah, pengiriman WhatsApp, dan QR Check-In
              dikelola terpisah untuk tiap pasangan.
            </p>

            <div class="mt-8 flex flex-col gap-5">
              {fitur.map((f) => (
                <div class="flex gap-3.5">
                  <span class="flex h-[26px] w-[26px] shrink-0 items-center justify-center rounded-full border border-(--adm-border) bg-(--adm-bg-secondary) text-(--adm-accent)">
                    <Check className="h-3.5 w-3.5" aria-hidden="true" />
                  </span>
                  <div>
                    <div class="text-sm font-semibold text-(--adm-text-primary)">{f.judul}</div>
                    <div class="mt-0.5 text-xs text-(--adm-text-secondary)">{f.isi}</div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    )}
  </div>

  <style>
    .auth-grid {
      display: grid;
      grid-template-columns: 1fr;
    }
    .auth-kanan {
      display: none;
      background-image: radial-gradient(var(--adm-border) 1px, transparent 1px);
      background-size: 24px 24px;
    }
    @media (min-width: 900px) {
      .auth-grid {
        grid-template-columns: 544px 1fr;
      }
      .auth-grid .auth-kiri {
        background: var(--adm-bg-secondary);
        border-right: 1px solid var(--adm-border);
      }
      .auth-kanan {
        display: flex;
      }
    }
    .auth-wide-bg {
      background-image:
        radial-gradient(ellipse 65% 320px at 50% 0%, var(--adm-accent-soft), transparent 75%),
        radial-gradient(var(--adm-border) 1px, transparent 1px);
      background-size:
        100% 420px,
        24px 24px;
      background-repeat: no-repeat, repeat;
    }
  </style>
</Layout>

<script>
  const btn = document.getElementById("auth-theme-toggle");
  btn?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");
    document.documentElement.setAttribute("data-theme", isDark ? "dark" : "light");
    try {
      localStorage.setItem("theme", isDark ? "dark" : "light");
    } catch {
      // ignore
    }
  });
</script>
