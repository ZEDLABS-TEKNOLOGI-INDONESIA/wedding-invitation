---
import { BookOpen, ChevronDown, Code2 } from "lucide-react";

export interface DocsTocItem {
  id: string;
  label: string;
}

export interface DocsSurround {
  href: string;
  title: string;
  description: string;
}

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  currentPath: string;
  toc: DocsTocItem[];
  prev?: DocsSurround;
  next?: DocsSurround;
}

const { eyebrow, title, description, currentPath, toc, prev, next } = Astro.props;

const grupPanduan = [
  { href: "/dokumentasi", label: "Dokumentasi Fitur" },
  { href: "/layanan-mandiri", label: "Panduan Layanan Mandiri" },
];

const grupReferensi = [
  { href: "/faq", label: "Pertanyaan Umum (FAQ)" },
  { href: "/syarat-ketentuan", label: "Syarat dan Ketentuan" },
  { href: "/kebijakan-privasi", label: "Kebijakan Privasi" },
  { href: "/bantuan", label: "Hubungi Bantuan" },
];

const adaSidebarExtra = Astro.slots.has("sidebar-extra");
---

<div class="mx-auto max-w-7xl px-4 sm:px-6">
  <div class="grid items-start lg:grid-cols-[240px_minmax(0,1fr)] lg:gap-8 xl:grid-cols-[240px_minmax(0,1fr)_220px] xl:gap-10">
    {/* Left sticky navigation tree (1:1 whatsapp-service DocsShell) */}
    <aside
      class="hidden max-h-[calc(100dvh-4rem)] overflow-y-auto border-r border-(--adm-border) py-8 pr-4 text-sm lg:sticky lg:top-16 lg:block"
      aria-label="Navigasi dokumentasi"
    >
      {Astro.slots.has("sidebar-top") && (
        <div class="mb-5">
          <slot name="sidebar-top" />
        </div>
      )}

      <div class="space-y-6">
        <div>
          <p class="mb-2 flex items-center gap-2 text-xs font-semibold text-(--adm-text-primary)">
            <BookOpen className="h-3.5 w-3.5 text-(--adm-accent)" aria-hidden="true" />
            Panduan
          </p>
          <ul class="ml-1.5 space-y-0.5 border-l border-(--adm-border)">
            {grupPanduan.map((item) => {
              const aktif = currentPath === item.href;
              return (
                <li>
                  <a
                    href={item.href}
                    aria-current={aktif ? "page" : undefined}
                    class:list={[
                      "-ml-px block border-l py-1.5 pl-3.5 text-[13px] transition-colors",
                      aktif
                        ? "border-l-2 border-(--adm-accent) font-semibold text-(--adm-accent)"
                        : "border-transparent text-(--adm-text-secondary) hover:border-(--adm-text-muted) hover:text-(--adm-text-primary)",
                    ]}
                  >
                    {item.label}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>

        <div>
          <p class="mb-2 flex items-center gap-2 text-xs font-semibold text-(--adm-text-primary)">
            <Code2 className="h-3.5 w-3.5 text-(--adm-accent)" aria-hidden="true" />
            Referensi &amp; Hukum
          </p>
          <ul class="ml-1.5 space-y-0.5 border-l border-(--adm-border)">
            {grupReferensi.map((item) => {
              const aktif = currentPath === item.href;
              return (
                <li>
                  <a
                    href={item.href}
                    aria-current={aktif ? "page" : undefined}
                    class:list={[
                      "-ml-px block border-l py-1.5 pl-3.5 text-[13px] transition-colors",
                      aktif
                        ? "border-l-2 border-(--adm-accent) font-semibold text-(--adm-accent)"
                        : "border-transparent text-(--adm-text-secondary) hover:border-(--adm-text-muted) hover:text-(--adm-text-primary)",
                    ]}
                  >
                    {item.label}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>

        {adaSidebarExtra && (
          <div class="border-t border-(--adm-border) pt-4">
            <slot name="sidebar-extra" />
          </div>
        )}
      </div>
    </aside>

    {/* Center main documentation prose */}
    <article class="min-w-0 py-6 sm:py-8">
      {/* Mobile/Tablet collapsible TOC & guide switcher */}
      <details class="mb-6 rounded-lg border border-(--adm-border) bg-(--adm-bg-secondary) px-4 py-2.5 xl:hidden">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-2 text-xs font-semibold text-(--adm-text-primary)">
          <span>Di halaman ini &amp; navigasi panduan</span>
          <ChevronDown className="h-4 w-4 text-(--adm-text-secondary)" aria-hidden="true" />
        </summary>
        <div class="mt-3 grid gap-4 border-t border-(--adm-border) pt-3 text-xs sm:grid-cols-2">
          {toc.length > 0 && (
            <nav aria-label="Daftar isi seluler">
              <p class="mb-1.5 font-semibold text-(--adm-text-primary)">Di halaman ini</p>
              <ul class="space-y-0.5 border-l border-(--adm-border) pl-3">
                {toc.map((item) => (
                  <li>
                    <a
                      href={`#${item.id}`}
                      class="block py-1 text-(--adm-text-secondary) hover:text-(--adm-accent)"
                    >
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )}
          <nav aria-label="Seri panduan seluler" class="lg:hidden">
            <p class="mb-1.5 font-semibold text-(--adm-text-primary)">Panduan &amp; Referensi</p>
            <ul class="space-y-0.5 border-l border-(--adm-border) pl-3">
              {[...grupPanduan, ...grupReferensi].map((item) => (
                <li>
                  <a
                    href={item.href}
                    class:list={[
                      "block py-1",
                      currentPath === item.href
                        ? "font-semibold text-(--adm-accent)"
                        : "text-(--adm-text-secondary) hover:text-(--adm-accent)",
                    ]}
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      </details>

      {/* Docs page header */}
      <header class="mb-8 border-b border-(--adm-border) pb-6">
        <p class="text-xs font-semibold text-(--adm-accent)">{eyebrow}</p>
        <h1 class="mt-1.5 text-2xl font-bold tracking-tight text-(--adm-text-primary) sm:text-3xl">
          {title}
        </h1>
        <p class="mt-2.5 text-sm leading-relaxed text-(--adm-text-secondary) sm:text-base">
          {description}
        </p>
        {Astro.slots.has("header-meta") && (
          <div class="mt-4 flex flex-wrap items-center gap-2 text-xs text-(--adm-text-secondary)">
            <slot name="header-meta" />
          </div>
        )}
      </header>

      {/* Main content slot */}
      <div class="space-y-8">
        <slot />
      </div>

      {/* Prev / Next surround cards */}
      {(prev || next) && (
        <nav
          aria-label="Halaman sebelumnya dan berikutnya"
          class="mt-12 grid gap-4 border-t border-(--adm-border) pt-8 sm:grid-cols-2"
        >
          {prev ? (
            <a
              href={prev.href}
              class="group flex flex-col gap-1.5 rounded-xl border border-(--adm-border) bg-(--adm-bg-secondary) p-5 transition-colors hover:border-(--adm-accent)"
            >
              <span class="mb-1 inline-flex h-7 w-7 items-center justify-center rounded-full border border-(--adm-border) bg-(--adm-bg-primary) text-(--adm-text-secondary) transition-colors group-hover:border-(--adm-accent) group-hover:text-(--adm-accent)">
                &larr;
              </span>
              <span class="text-sm font-semibold text-(--adm-text-primary) transition-colors group-hover:text-(--adm-accent)">
                {prev.title}
              </span>
              <span class="text-xs leading-relaxed text-(--adm-text-secondary)">
                {prev.description}
              </span>
            </a>
          ) : (
            <div class="hidden sm:block" />
          )}

          {next && (
            <a
              href={next.href}
              class="group flex flex-col gap-1.5 rounded-xl border border-(--adm-border) bg-(--adm-bg-secondary) p-5 transition-colors hover:border-(--adm-accent) sm:items-end sm:text-right"
            >
              <span class="mb-1 inline-flex h-7 w-7 items-center justify-center rounded-full border border-(--adm-border) bg-(--adm-bg-primary) text-(--adm-text-secondary) transition-colors group-hover:border-(--adm-accent) group-hover:text-(--adm-accent)">
                &rarr;
              </span>
              <span class="text-sm font-semibold text-(--adm-text-primary) transition-colors group-hover:text-(--adm-accent)">
                {next.title}
              </span>
              <span class="text-xs leading-relaxed text-(--adm-text-secondary)">
                {next.description}
              </span>
            </a>
          )}
        </nav>
      )}
    </article>

    {/* Right sticky Table of Contents */}
    <aside
      class="hidden max-h-[calc(100dvh-4rem)] overflow-y-auto py-8 pl-4 text-xs xl:sticky xl:top-16 xl:block"
      aria-label="Daftar isi halaman"
    >
      {toc.length > 0 && (
        <nav aria-label="Di halaman ini">
          <p class="mb-3 font-semibold text-(--adm-text-primary)">Di halaman ini</p>
          <ul class="space-y-0.5 border-l border-(--adm-border)">
            {toc.map((item) => (
              <li>
                <a
                  href={`#${item.id}`}
                  data-docs-toc={item.id}
                  class="docs-toc-link -ml-px block border-l border-transparent py-1 pl-3 leading-snug text-(--adm-text-secondary) transition-colors hover:text-(--adm-text-primary)"
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}

      <div class="mt-6 space-y-2 border-t border-(--adm-border) pt-5">
        <p class="font-semibold text-(--adm-text-primary)">Dukungan</p>
        <ul class="space-y-1 text-(--adm-text-secondary)">
          <li>
            <a
              href="/faq"
              class="inline-flex items-center gap-1.5 py-0.5 transition-colors hover:text-(--adm-accent)"
            >
              Pertanyaan Umum (FAQ)
            </a>
          </li>
          <li>
            <a
              href="/bantuan"
              class="inline-flex items-center gap-1.5 py-0.5 transition-colors hover:text-(--adm-accent)"
            >
              Hubungi tim bantuan
            </a>
          </li>
          <li>
            <a
              href="/demo"
              class="inline-flex items-center gap-1.5 py-0.5 transition-colors hover:text-(--adm-accent)"
            >
              Lihat Demo Undangan
            </a>
          </li>
        </ul>
      </div>
    </aside>
  </div>
</div>

<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-docs-toc]"));
  if (links.length > 0) {
    const map = new Map<string, HTMLAnchorElement>();
    for (const a of links) {
      const id = a.dataset.docsToc;
      if (id) map.set(id, a);
    }

    const setActive = (id: string) => {
      for (const a of links) {
        a.classList.remove("is-toc-active");
      }
      map.get(id)?.classList.add("is-toc-active");
    };

    const firstId = links[0]?.dataset.docsToc;
    if (firstId) setActive(firstId);

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            setActive(entry.target.id);
          }
        }
      },
      { rootMargin: "-18% 0px -72% 0px" },
    );

    map.forEach((_, id) => {
      const el = document.getElementById(id);
      if (el) io.observe(el);
    });
  }
</script>

<style>
  .docs-toc-link.is-toc-active {
    border-left-width: 2px;
    border-left-color: var(--adm-accent);
    color: var(--adm-accent);
    font-weight: 600;
  }
</style>
