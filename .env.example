# Port host Docker (default 4321)
APP_PORT=4321

# URL publik aplikasi (tanpa garis miring di akhir)
SITE_URL=https://wedding.zedlabs.id

# Nama file database SQLite di dalam folder ./database
DB_NAME=wedding.db

# Akun Superadmin awal (dibuat otomatis saat pertama kali dijalankan)
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=ganti-dengan-password-superadmin-kuat
SUPERADMIN_PHONE=081234567890

# Password fallback admin & secret acak minimal 32 karakter untuk cookie sesi
ADMIN_PASSWORD=ganti-dengan-password-kuat
SESSION_SECRET=ganti-dengan-random-secret-minimal-32-karakter
